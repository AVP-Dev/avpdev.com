---
// src/pages/404.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---
<BaseLayout
    title={lang === 'ru' ? '404: Сектор не найден • AVP-Dev' : '404: Sector Not Found • AVP-Dev'}
    description={lang === 'ru' ? 'Страница не найдена. Нажмите Start для возврата на главную.' : 'Page not found. Press Start to return home.'}
    noindex={true}
>
    <main class="error-page-content">
        <div class="container error-container">
            <div class="retro-404-card">
                <div class="error-badge">● SIGNAL LOST ● CODE 404</div>
                <div class="error-glitch-title" data-text="404">404</div>
                <h1 class="error-heading">
                    {lang === 'ru' ? '👾 GAME OVER: СЕКТОР НЕ НАЙДЕН 👾' : '👾 GAME OVER: SECTOR NOT FOUND 👾'}
                </h1>
                <p class="error-desc">
                    {lang === 'ru' 
                        ? 'Координаты гиперпространственного перехода повреждены. Вставьте монетку или телепортируйтесь на базу.' 
                        : 'Hyperspace coordinates corrupted. Insert coin or teleport back to home base.'}
                </p>

                <!-- Arcade Countdown & Coin Box -->
                <div class="arcade-status-panel">
                    <div class="arcade-countdown-box">
                        <span class="cd-label">{lang === 'ru' ? 'АВТО-ТЕЛЕПОРТАЦИЯ:' : 'AUTO-RESPAWN IN:'}</span>
                        <span id="retro-404-timer" class="cd-digits">15</span>
                    </div>

                    <button type="button" id="retro-insert-coin-btn" class="retro-insert-coin-btn">
                        <span class="coin-icon">🪙</span>
                        <span>{lang === 'ru' ? 'ВСТАВИТЬ МОНЕТКУ [INSERT COIN]' : 'INSERT COIN [CONTINUE]'}</span>
                    </button>
                </div>

                <!-- Hidden Secret Promo Bonus Card -->
                <div id="retro-404-bonus-card" class="retro-404-bonus-card" style="display: none;">
                    <div class="bonus-tag">★ SECRET CHEAT CODE UNLOCKED ★</div>
                    <div class="bonus-code">PROMO CODE: <span>RETRO404</span></div>
                    <p class="bonus-desc">
                        {lang === 'ru' 
                            ? '10% скидка на архитектурный проект и разработку при заказе через бриф!' 
                            : '10% discount on software architecture & design in project brief!'}
                    </p>
                    <a href={`/${lang}/brief/`} class="bonus-brief-link">
                        {lang === 'ru' ? '⚡ АКТИВИРОВАТЬ В БРИФЕ ▶' : '⚡ ACTIVATE IN BRIEF ▶'}
                    </a>
                </div>

                <!-- Action Buttons -->
                <div class="error-actions">
                    <a href={`/${lang}/`} class="retro-action-btn primary-btn">
                        <i class="fa-solid fa-house"></i> {lang === 'ru' ? '▶ НА ГЛАВНУЮ' : '▶ RESPAWN HOME'}
                    </a>
                    <button type="button" class="retro-action-btn arcade-btn" data-open-arcade>
                        <i class="fa-solid fa-gamepad"></i> {lang === 'ru' ? '🕹️ ИГРАТЬ В АРКАДУ' : '🕹️ PLAY ARCADE'}
                    </button>
                    <button type="button" class="retro-action-btn terminal-btn" data-open-terminal>
                        <i class="fa-solid fa-terminal"></i> {lang === 'ru' ? '💻 ТЕРМИНАЛ' : '💻 CLI_OS'}
                    </button>
                </div>
            </div>
        </div>
    </main>
</BaseLayout>

<script>
    import { retroAudio } from '../scripts/retroAudio';
    import { retroAchievements } from '../scripts/retroAchievements';

    let countdown = 15;
    const timerEl = document.getElementById('retro-404-timer');
    const insertCoinBtn = document.getElementById('retro-insert-coin-btn');
    const bonusCard = document.getElementById('retro-404-bonus-card');
    const lang = document.documentElement.lang === 'en' ? 'en' : 'ru';

    if (insertCoinBtn) {
        insertCoinBtn.addEventListener('click', () => {
            countdown = 99;
            if (timerEl) timerEl.textContent = '99';
            retroAudio.playCoinInsert();
            retroAchievements.unlock('insert_coin');
            insertCoinBtn.classList.add('inserted');
            insertCoinBtn.innerHTML = `<span>🪙 ${lang === 'ru' ? 'МОНЕТКА ПРИНЯТА (+99 SEC)' : 'CREDIT ACCEPTED (+99 SEC)'}</span>`;
            if (bonusCard) {
                bonusCard.style.display = 'block';
            }
        });
    }

    if (timerEl) {
        const interval = setInterval(() => {
            countdown--;
            if (countdown >= 0) {
                timerEl.textContent = countdown < 10 ? `0${countdown}` : `${countdown}`;
                if (document.documentElement.classList.contains('retro-mode') && countdown <= 10 && countdown > 0) {
                    retroAudio.playClick();
                }
            }
            if (countdown <= 0) {
                clearInterval(interval);
                window.location.href = `/${lang}/`;
            }
        }, 1000);
    }
</script>

<style>
.error-page-content {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100dvh;
    padding-top: calc(110px + 2.5rem);
    padding-bottom: 5rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    text-align: center;
    position: relative;
    box-sizing: border-box;
}

@media (max-width: 768px) {
    .error-page-content {
        padding-top: calc(90px + 2rem);
        padding-bottom: 5rem;
        min-height: auto;
    }
}

.retro-404-card {
    max-width: 640px;
    margin: 0 auto;
    background: rgba(14, 10, 26, 0.85);
    border: 2px solid #ff007f;
    border-radius: 12px;
    padding: 2.5rem 2rem;
    box-shadow: 0 0 40px rgba(255, 0, 127, 0.35), inset 0 0 25px rgba(255, 0, 127, 0.15);
    position: relative;
    backdrop-filter: blur(12px);
}

.error-badge {
    display: inline-block;
    font-family: var(--font-pixel, monospace);
    font-size: 0.6rem;
    color: #ffe600;
    background: rgba(255, 230, 0, 0.15);
    border: 1px dashed #ffe600;
    padding: 4px 12px;
    border-radius: 4px;
    margin-bottom: 1rem;
    letter-spacing: 0.08em;
}

.error-glitch-title {
    font-family: var(--font-pixel, monospace);
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 900;
    color: #00f0ff;
    text-shadow: 0 0 20px #00f0ff, 0 0 40px #ff007f;
    line-height: 1;
    margin-bottom: 1rem;
    letter-spacing: 0.08em;
    animation: retro-pulse 1.2s infinite alternate;
}

.error-heading {
    font-family: var(--font-pixel, monospace);
    font-size: clamp(0.9rem, 2.5vw, 1.25rem);
    color: #ff007f;
    text-shadow: 0 0 10px #ff007f;
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
}

.error-desc {
    font-size: 1rem;
    color: #a4bed9;
    line-height: 1.6;
    margin-bottom: 1.8rem;
}

.arcade-status-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 2rem;
}

.arcade-countdown-box {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(0, 0, 0, 0.6);
    border: 1.5px solid #ffe600;
    padding: 0.5rem 1.2rem;
    border-radius: 6px;
    box-shadow: 0 0 15px rgba(255, 230, 0, 0.3);
}

.cd-label {
    font-family: var(--font-pixel, monospace);
    font-size: 0.6rem;
    color: #ffe600;
    letter-spacing: 0.05em;
}

.cd-digits {
    font-family: var(--font-pixel, monospace);
    font-size: 1.2rem;
    color: #00ff66;
    text-shadow: 0 0 10px #00ff66;
    font-weight: bold;
}

.retro-insert-coin-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 230, 0, 0.15);
    border: 1.5px solid #ffe600;
    color: #ffe600;
    font-family: var(--font-pixel, monospace);
    font-size: 0.62rem;
    padding: 0.65rem 1.2rem;
    border-radius: 6px;
    cursor: pointer;
    box-shadow: 0 0 15px rgba(255, 230, 0, 0.4);
    animation: retro-pulse 1.5s infinite alternate;
    transition: all 0.2s ease;
}

.retro-insert-coin-btn:hover {
    background: #ffe600;
    color: #080612;
    box-shadow: 0 0 25px #ffe600;
    transform: scale(1.05);
}

.retro-insert-coin-btn.inserted {
    background: rgba(0, 255, 102, 0.2);
    border-color: #00ff66;
    color: #00ff66;
    box-shadow: 0 0 15px rgba(0, 255, 102, 0.4);
    animation: none;
    pointer-events: none;
}

.retro-404-bonus-card {
    background: rgba(6, 4, 18, 0.95);
    border: 1.5px dashed #00ff66;
    border-radius: 8px;
    padding: 1.2rem 1.5rem;
    margin-bottom: 2rem;
    box-shadow: 0 0 25px rgba(0, 255, 102, 0.3);
    animation: retro-pulse 2s infinite alternate;
}

.bonus-tag {
    font-family: var(--font-pixel, monospace);
    font-size: 0.55rem;
    color: #00ff66;
    margin-bottom: 0.5rem;
    letter-spacing: 0.08em;
}

.bonus-code {
    font-family: var(--font-pixel, monospace);
    font-size: 0.95rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
}

.bonus-code span {
    color: #ffe600;
    text-shadow: 0 0 10px #ffe600;
    background: rgba(255, 230, 0, 0.15);
    padding: 2px 8px;
    border-radius: 4px;
}

.bonus-desc {
    font-size: 0.85rem;
    color: #9eb7d6;
    margin-bottom: 0.85rem;
}

.bonus-brief-link {
    display: inline-block;
    font-family: var(--font-pixel, monospace);
    font-size: 0.62rem;
    color: #00f0ff;
    text-decoration: underline;
    text-shadow: 0 0 8px #00f0ff;
}

.error-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
}

.retro-action-btn {
    font-family: var(--font-pixel, monospace);
    font-size: 0.65rem;
    padding: 0.65rem 1.2rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1.5px solid transparent;
}

.retro-action-btn.primary-btn {
    background: #ff007f;
    color: #ffffff;
    border-color: #ff007f;
    box-shadow: 0 0 15px rgba(255, 0, 127, 0.6);
}

.retro-action-btn.primary-btn:hover {
    background: #ffffff;
    color: #ff007f;
    box-shadow: 0 0 25px #ff007f;
    transform: translateY(-2px);
}

.retro-action-btn.arcade-btn {
    background: rgba(0, 240, 255, 0.15);
    color: #00f0ff;
    border-color: #00f0ff;
    box-shadow: 0 0 12px rgba(0, 240, 255, 0.3);
}

.retro-action-btn.arcade-btn:hover {
    background: #00f0ff;
    color: #040308;
    box-shadow: 0 0 20px #00f0ff;
    transform: translateY(-2px);
}

.retro-action-btn.terminal-btn {
    background: rgba(0, 255, 102, 0.15);
    color: #00ff66;
    border-color: #00ff66;
    box-shadow: 0 0 12px rgba(0, 255, 102, 0.3);
}

.retro-action-btn.terminal-btn:hover {
    background: #00ff66;
    color: #040308;
    box-shadow: 0 0 20px #00ff66;
    transform: translateY(-2px);
}

@media (max-width: 600px) {
    .retro-404-card {
        padding: 1.8rem 1.2rem;
    }

    .error-actions {
        flex-direction: column;
        width: 100%;
        gap: 10px;
    }

    .retro-action-btn {
        width: 100%;
        justify-content: center;
    }

    .arcade-status-panel {
        flex-direction: column;
        width: 100%;
    }

    .retro-insert-coin-btn,
    .arcade-countdown-box {
        width: 100%;
        justify-content: center;
    }
}
</style>