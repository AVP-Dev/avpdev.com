---
// src/pages/en/services/[city].astro
import GeoPageLayout from '../../../layouts/GeoPageLayout.astro';
import GeoBlogPosts from '../../../components/sections/GeoBlogPosts.astro';
import AccordionItem from '../../../components/AccordionItem.astro';
import { locations } from '../../../data/locations';
import { getCollection } from 'astro:content';
import { getDeterministicItems, hashSlug } from '../../../utils/random';

export const prerender = true;

export async function getStaticPaths() {
    const allGeo = await getCollection('geo');
    return allGeo
        .filter(entry => entry.data.en || entry.data.ru) // Only build if there is SOME content
        .map(entry => ({
            params: { city: entry.id },
            props: { geoEntry: entry },
        }));
}

const { city } = Astro.params;
const { geoEntry } = Astro.props;
const cityData = locations.find(loc => loc.slug === city);
const content = geoEntry.data.en;

if (!cityData) {
    return new Response(null, { status: 404 });
}

if (!content) {
    if (geoEntry.data.ru) {
        return Astro.redirect(`/ru/uslugi/${city}/`, 301);
    }
    return new Response(null, { status: 404 });
}

const lang = 'en';
const allProjects = await getCollection('projects', ({ id }) => id.startsWith(lang + '/'));
const projects = allProjects.slice(0, 6);

// Per-city stable random selection of 2 blog posts.
const allBlogPosts = await getCollection('blog', ({ id, data }) =>
  id.startsWith('en/') && data.draft !== true,
);
const cityBlogPosts = allBlogPosts.length > 0
  ? getDeterministicItems(allBlogPosts, 2, hashSlug(city))
  : [];

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "inLanguage": "en-US",
  "serviceType": "Web Development",
  "provider": {
    "@type": "Organization",
    "name": "AVPdev.com",
    "url": Astro.site?.toString()
  },
  "areaServed": {
    "@type": "City",
    "name": cityData.name_en
  },
  "name": content.title,
  "description": content.description,
  "url": Astro.url.href
};

const faqSchema = content.faq && content.faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "en-US",
  "mainEntity": content.faq.map((f: any) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
} : null;
---
<GeoPageLayout
    title={content.title}
    description={content.description}
    h1={content.h1}
    p={content.p}
    projects={projects}
    citySlug={city}
    cityName={cityData.name_en || undefined}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    {faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <section class="city-specific-content container fade-in">
    <h2 class="section-title">Why choose AVPdev in {cityData.name_en}</h2>
    <div class="benefits-grid">
      {content.benefits ? (
        content.benefits.map((b: { icon: string; title: string; desc: string }) => (
          <div class="benefit-item">
            <i class={`fas ${b.icon}`}></i>
            <h3>{b.title}</h3>
            <p>{b.desc}</p>
          </div>
        ))
      ) : (
        <Fragment>
          <div class="benefit-item">
            <i class="fas fa-rocket"></i>
            <h3>Speed</h3>
            <p>Your website will be lightning fast, providing the best user experience in {cityData.name_en}.</p>
          </div>
          <div class="benefit-item">
            <i class="fas fa-search"></i>
            <h3>SEO Focus</h3>
            <p>Local optimization specifically for the {cityData.name_en} market.</p>
          </div>
        </Fragment>
      )}
    </div>
  </section>

  {content.faq && content.faq.length > 0 && (
    <section class="faq-section container fade-in" style="margin-top: 4rem;">
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="acc-list" data-accordion>
        {content.faq.map((item: { q: string; a: string }) => (
          <AccordionItem q={item.q} a={item.a} />
        ))}
      </div>
    </section>
  )}

  <GeoBlogPosts posts={cityBlogPosts} />
</GeoPageLayout>

<style>
  .city-specific-content {
    padding: 6rem 0;
    text-align: center;
  }
  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
    margin-top: 4rem;
  }
  .benefit-item i {
    font-size: 3rem;
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 1.5rem;
  }
  .benefit-item h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }
  .faq-section {
    padding-bottom: 6rem;
  }
</style>