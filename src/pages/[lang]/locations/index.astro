---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { locations } from '../../../data/locations';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../../i18n/utils';

export const prerender = true;

export async function getStaticPaths() {
    return [
        { params: { lang: 'ru' } },
        { params: { lang: 'en' } },
    ];
}

const { lang } = Astro.params;
const currentLang = lang || 'ru';
const t = useTranslations(currentLang as 'ru' | 'en');

const allGeo = await getCollection('geo');
const geoMap = Object.fromEntries(allGeo.map(e => [e.id, e.data]));

// Названия стран
const countryNames: Record<string, {ru: string, en: string}> = {
    'RU': { ru: 'Россия', en: 'Russia' },
    'BY': { ru: 'Беларусь', en: 'Belarus' },
    'KZ': { ru: 'Казахстан', en: 'Kazakhstan' },
    'PL': { ru: 'Польша', en: 'Poland' },
    'CZ': { ru: 'Чехия', en: 'Czech Republic' },
    'DE': { ru: 'Германия', en: 'Germany' },
    'LT': { ru: 'Литва', en: 'Lithuania' },
    'LV': { ru: 'Латвия', en: 'Latvia' },
    'EE': { ru: 'Эстония', en: 'Estonia' },
    'NL': { ru: 'Нидерланды', en: 'Netherlands' },
    'GB': { ru: 'Великобритания', en: 'United Kingdom' },
    'FR': { ru: 'Франция', en: 'France' },
    'ES': { ru: 'Испания', en: 'Spain' },
    'IT': { ru: 'Италия', en: 'Italy' },
    'AE': { ru: 'ОАЭ', en: 'United Arab Emirates' },
    'SG': { ru: 'Сингапур', en: 'Singapore' },
    'JP': { ru: 'Япония', en: 'Japan' },
    'US': { ru: 'США', en: 'United States' },
    'CA': { ru: 'Канада', en: 'Canada' },
    'AU': { ru: 'Австралия', en: 'Australia' }
};

// Привязка стран к регионам 
const regionsMap: Record<string, string> = {
    'RU': 'cis', 'BY': 'cis', 'KZ': 'cis',
    'PL': 'europe', 'CZ': 'europe', 'DE': 'europe', 'LT': 'europe', 'LV': 'europe', 'EE': 'europe', 'NL': 'europe', 'GB': 'europe', 'FR': 'europe', 'ES': 'europe', 'IT': 'europe',
    'AE': 'asia', 'SG': 'asia', 'JP': 'asia',
    'US': 'americas', 'CA': 'americas', 'AU': 'americas'
};

const filterTabs = [
    { id: 'all', label: t('locations_filter_all') },
    { id: 'cis', label: t('locations_filter_cis') },
    { id: 'europe', label: t('locations_filter_europe') },
    { id: 'asia', label: t('locations_filter_asia') },
    { id: 'americas', label: t('locations_filter_americas') },
];

// Фильтруем города по языку (теперь показываем все везде)
const availableLocations = locations;

// Группировка по странам
const groupedLocations = availableLocations.reduce((acc, loc) => {
    if (!acc[loc.country]) {
        acc[loc.country] = [];
    }
    acc[loc.country].push(loc);
    return acc;
}, {} as Record<string, typeof locations>);

// Сортировка стран
const sortedCountries = Object.keys(groupedLocations).sort((a, b) => {
    const nameA = countryNames[a]?.[currentLang as 'ru' | 'en'] || a;
    const nameB = countryNames[b]?.[currentLang as 'ru' | 'en'] || b;
    return nameA.localeCompare(nameB);
});

const pageTitle = t('locations_page_title');
const pageDescription = t('locations_page_desc');
---

<BaseLayout title={pageTitle} description={pageDescription} noindex={true}>
    <div class="locations-page">
        <section class="locations-hero relative">
            <div id="particles-js"></div>
            <div class="glow-bg top-glow"></div>
            <div class="container text-center relative z-10 mx-auto px-4 pt-32 pb-16">
                <h1 class="font-extrabold mb-6 tracking-tight section-title text-5xl lg:text-6xl">
                    {t('locations_h1_pre')}<span class="gradient-text">{t('locations_h1_accent')}</span>
                </h1>
                <p class="section-subtitle">
                    {t('locations_subtitle')}
                </p>
                
                <!-- Filter Tabs -->
                <div class="tabs-container">
                    <div class="tabs-scroll" role="tablist">
                        {filterTabs.map((tab, idx) => {
                            // Only show tabs that have countries visible in the current language
                            if(tab.id !== 'all') {
                                const hasVisibleCountriesInTab = sortedCountries.some(c => regionsMap[c] === tab.id);
                                if(!hasVisibleCountriesInTab) return null;
                            }
                            return (
                                <button 
                                    class={`tab-btn ${idx === 0 ? 'active' : ''}`} 
                                    data-filter={tab.id}
                                    role="tab"
                                    aria-selected={idx === 0 ? "true" : "false"}
                                >
                                    {tab.label}
                                </button>
                            );
                        })}
                    </div>
                </div>
            </div>
        </section>

        <section class="locations-grid container mx-auto px-4 pb-32 relative z-10">
            <div class="grid layout-grid" id="countries-grid">
                {sortedCountries.map(countryCode => {
                    const countryName = countryNames[countryCode]?.[currentLang as 'ru' | 'en'] || countryCode;
                    const region = regionsMap[countryCode] || 'other';
                    const cities = groupedLocations[countryCode];
                    
                    // Sorting cities alphabetically within the country
                    cities.sort((a, b) => {
                        const nameA = (currentLang === 'ru' ? a.name_ru : a.name_en) || a.slug;
                        const nameB = (currentLang === 'ru' ? b.name_ru : b.name_en) || b.slug;
                        return nameA.localeCompare(nameB);
                    });

                    const VISIBLE_LIMIT = 8;
                    const visibleCities = cities.slice(0, VISIBLE_LIMIT);
                    const hiddenCities = cities.slice(VISIBLE_LIMIT);
                    const hasHidden = hiddenCities.length > 0;
                    
                    const textShow = t('locations_show_all').replace('{count}', String(cities.length));
                    const textHide = t('locations_show_less');

                    return (
                        <article class="country-card card fade-in" data-region={region}>
                            <h2 class="country-title flex items-center gap-3 border-border-color">
                                <span class="country-icon text-accent-color-start text-2xl">
                                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                </span>
                                {countryName}
                            </h2>
                            <ul class="cities-list mt-6 grid grid-cols-2 gap-3" aria-label={`Cities in ${countryName}`}>
                                {visibleCities.map(loc => {
                                    const cityName = (currentLang === 'ru' ? loc.name_ru : loc.name_en) || loc.name_en || loc.name_ru || loc.slug;
                                    // Always use EN URL for cities without RU content — avoids redirect chain / 404
                                    const hasRuContent = !!geoMap[loc.slug]?.ru;
                                    const url = (currentLang === 'ru' && hasRuContent)
                                        ? `/ru/uslugi/${loc.slug}/`
                                        : `/en/services/${loc.slug}/`;
                                    return (
                                        <li>
                                            <a href={url} class="city-pill group">
                                                <span class="city-name">{cityName?.replace(/е$/, 'е')}</span>
                                                <i class="fas fa-arrow-right city-arrow" aria-hidden="true"></i>
                                            </a>
                                        </li>
                                    );
                                })}
                                {hasHidden && hiddenCities.map(loc => {
                                    const cityName = (currentLang === 'ru' ? loc.name_ru : loc.name_en) || loc.name_en || loc.name_ru || loc.slug;
                                    // Always use EN URL for cities without RU content — avoids redirect chain / 404
                                    const hasRuContent = !!geoMap[loc.slug]?.ru;
                                    const url = (currentLang === 'ru' && hasRuContent)
                                        ? `/ru/uslugi/${loc.slug}/`
                                        : `/en/services/${loc.slug}/`;
                                    return (
                                        <li class="hidden-city-item" style="display: none;">
                                            <a href={url} class="city-pill group">
                                                <span class="city-name">{cityName?.replace(/е$/, 'е')}</span>
                                                <i class="fas fa-arrow-right city-arrow" aria-hidden="true"></i>
                                            </a>
                                        </li>
                                    );
                                })}
                            </ul>
                            {hasHidden && (
                                <button 
                                    class="toggle-cities-btn mt-5 flex items-center gap-2 self-start w-full justify-center md:w-auto"
                                    data-text-show={textShow}
                                    data-text-hide={textHide}
                                    aria-expanded="false"
                                >
                                    <span>{textShow}</span>
                                    <i class="fas fa-chevron-down transition-transform duration-300"></i>
                                </button>
                            )}
                        </article>
                    );
                })}
            </div>
            
            <div id="no-results" class="hidden text-center py-16">
                <p class="text-xl text-text-secondary">{t('locations_no_results')}</p>
            </div>
        </section>
    </div>
</BaseLayout>

<script>
    // Tab Filtering Logic + URLSearchParams auto-filter (Footer deep-links: ?region=cis/europe/americas)
    function initFilters() {
        const tabs = document.querySelectorAll('.tab-btn');
        const cards = document.querySelectorAll('.country-card');
        const noResults = document.getElementById('no-results');

        if (!tabs.length || !cards.length) return;

        const VALID_FILTERS = ['all', 'cis', 'europe', 'asia', 'americas'];
        const ALIAS_MAP = {
            usa: 'americas',
            us: 'americas',
            america: 'americas',
            'america & oceania': 'americas',
        } as Record<string, string>;

        function normalizeFilter(raw: string | null): string | null {
            if (!raw) return null;
            let v = raw.toLowerCase().trim();
            if ((ALIAS_MAP as Record<string, string>)[v]) v = (ALIAS_MAP as Record<string, string>)[v];
            return VALID_FILTERS.includes(v) ? v : null;
        }

        function getRegionFromUrl(): string | null {
            try {
                const params = new URLSearchParams(window.location.search);
                let raw = params.get('region') || params.get('filter') || '';
                if (!raw) {
                    const hash = window.location.hash.replace(/^#/, '');
                    raw = hash;
                }
                return normalizeFilter(raw);
            } catch {
                return null;
            }
        }

        function applyFilter(filterValue: string | null, updateUrl = false) {
            const normalized = normalizeFilter(filterValue) || 'all';
            let count = 0;

            // Update active tab
            tabs.forEach((t) => {
                const isActive = t.getAttribute('data-filter') === normalized;
                t.classList.toggle('active', isActive);
                t.setAttribute('aria-selected', isActive ? 'true' : 'false');
            });

            cards.forEach((card) => {
                const el = card as HTMLElement;
                if (normalized === 'all' || el.dataset.region === normalized) {
                    el.style.display = 'flex';
                    void el.offsetWidth;
                    el.classList.add('fade-in');
                    setTimeout(() => el.classList.add('visible'), 50);
                    count++;
                } else {
                    el.style.display = 'none';
                    el.classList.remove('visible');
                }
            });

            if (noResults) {
                (noResults as HTMLElement).style.display = count === 0 ? 'block' : 'none';
            }

            if (updateUrl) {
                try {
                    const url = new URL(window.location.href);
                    if (normalized === 'all') {
                        url.searchParams.delete('region');
                        url.searchParams.delete('filter');
                        if (url.hash) url.hash = '';
                    } else {
                        url.searchParams.set('region', normalized);
                        url.searchParams.delete('filter');
                        if (url.hash) url.hash = '';
                    }
                    history.replaceState(null, '', url.toString());
                } catch {}
            }
        }

        // Attach tab listeners once (avoid double bind on astro:page-load)
        tabs.forEach((tab) => {
            const el = tab as HTMLElement;
            if (el.dataset.filterListener === 'true') return;
            el.dataset.filterListener = 'true';
            tab.addEventListener('click', () => {
                const filterValue = tab.getAttribute('data-filter');
                applyFilter(filterValue, true);
            });
        });

        // Auto-apply filter from URL (?region=cis / ?filter=cis / #cis) on first load
        const initial = getRegionFromUrl();
        if (initial && initial !== 'all') {
            applyFilter(initial, false);
        } else {
            // Initial animation - much simpler to avoid main thread jank
            requestAnimationFrame(() => {
                cards.forEach((card) => {
                    card.classList.add('visible');
                });
            });
        }

        // Show More Logic
        const toggleBtns = document.querySelectorAll('.toggle-cities-btn');
        toggleBtns.forEach(btn => {
            // Remove old listeners if any by cloning (to prevent double fire on Astro swaps)
            const newBtn = btn.cloneNode(true) as HTMLElement;
            btn.parentNode?.replaceChild(newBtn, btn);

            newBtn.addEventListener('click', () => {
                const card = newBtn.closest('.country-card');
                if (!card) return;
                
                const hiddenItems = card.querySelectorAll<HTMLElement>('.hidden-city-item');
                const isExpanded = newBtn.getAttribute('aria-expanded') === 'true';
                const textSpan = newBtn.querySelector('span');
                const icon = newBtn.querySelector('i');

                if (isExpanded) {
                    hiddenItems.forEach(item => { item.style.display = 'none'; });
                    newBtn.setAttribute('aria-expanded', 'false');
                    if (textSpan) textSpan.textContent = newBtn.getAttribute('data-text-show');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                } else {
                    hiddenItems.forEach(item => { 
                        item.style.display = ''; 
                        item.style.animation = 'fadeInOpacity 0.3s ease-in-out';
                    });
                    newBtn.setAttribute('aria-expanded', 'true');
                    if (textSpan) textSpan.textContent = newBtn.getAttribute('data-text-hide');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                }
            });
        });
    }

    // Run on first load and on astro page swaps
    document.addEventListener('DOMContentLoaded', initFilters);
    document.addEventListener('astro:page-load', initFilters);
</script>

<style>
    .locations-page {
        background-color: var(--bg-color);
        position: relative;
        overflow-x: hidden;
    }

    .glow-bg {
        position: absolute;
        width: 800px;
        height: 800px;
        background: radial-gradient(circle, var(--accent-color-start) 0%, transparent 70%);
        opacity: 0.15;
        filter: blur(100px);
        z-index: 0;
        pointer-events: none;
    }

    .top-glow {
        top: -300px;
        left: 50%;
        transform: translateX(-50%);
        will-change: transform; /* OK here as it's only one large element */
    }

    /* Tabs Styling */
    .tabs-container {
        display: flex;
        justify-content: center;
        width: 100%;
        margin-top: 3rem;
        position: relative;
        z-index: 20;
    }

    @media (max-width: 768px) {
        .tabs-container {
            justify-content: flex-start;
            padding: 0 1rem;
            margin-top: 2rem;
            /* Use a simpler approach for mobile to avoid scroll lag */
            overflow: hidden;
        }
    }

    .tabs-scroll {
        display: flex;
        gap: 0.5rem;
        padding: 0.4rem;
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 999px;
        overflow-x: auto;
        -ms-overflow-style: none;  /* IE and Edge */
        scrollbar-width: none;  /* Firefox */
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        margin: 0 auto;
        max-width: 100%;
    }

    .tabs-scroll::-webkit-scrollbar {
        display: none;
    }

    .tab-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary-color);
        font-family: var(--font-body);
        font-weight: 500;
        font-size: 0.95rem;
        padding: 0.7rem 1.1rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        white-space: nowrap;
        scroll-snap-align: center;
    }

    @media (max-width: 768px) {
        .tab-btn {
            font-size: 0.85rem;
            padding: 0.6rem 0.9rem;
        }
    }

    .tab-btn:hover {
        color: var(--text-color);
        background: rgba(255, 255, 255, 0.05);
    }

    .tab-btn.active {
        background: var(--accent-gradient);
        color: var(--card-bg, #0d0d0d); /* Always dark text over bright gradient */
        font-weight: 700;
        box-shadow: 0 4px 15px rgba(var(--accent-color-start-rgb), 0.3);
    }
    
    .light-theme .tab-btn.active {
        color: #fff;
    }

    /* Grid Layout */
    .layout-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    /* Card Overrides */
    .country-card {
        padding: 2rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        /* Performance boost: only render what's near the viewport */
        content-visibility: auto;
        contain-intrinsic-size: 1px 400px;
    }

    .country-title {
        font-family: var(--font-heading);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 0;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-color);
    }

    /* City Pills */
    .cities-list {
        list-style: none;
        padding: 0;
        flex-grow: 1;
        align-content: flex-start;
    }

    .city-pill {
        display: flex;
        align-items: center;
        justify-content: space-between;
        text-decoration: none;
        padding: 0.6rem 0.8rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid transparent;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .city-name {
        color: var(--text-secondary-color);
        font-size: 0.95rem;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .city-arrow {
        color: var(--accent-color-start);
        font-size: 0.85rem;
        opacity: 0;
        transform: translateX(-5px);
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .city-pill:hover,
    .city-pill:focus-visible {
        background: rgba(var(--accent-color-start-rgb), 0.08);
        border-color: rgba(var(--accent-color-start-rgb), 0.3);
        outline: none;
    }

    .city-pill:hover .city-name,
    .city-pill:focus-visible .city-name {
        color: var(--text-color);
    }

    .city-pill:hover .city-arrow,
    .city-pill:focus-visible .city-arrow {
        opacity: 1;
        transform: translateX(0);
    }

    /* Animations */
    .fade-in {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.4s ease-out, transform 0.4s ease-out;
    }

    .fade-in.visible {
        opacity: 1;
        transform: translateY(0);
    }

    /* Show More Toggle Button */
    .toggle-cities-btn {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid transparent;
        color: var(--text-secondary-color);
        font-family: var(--font-body);
        font-weight: 500;
        font-size: 0.95rem;
        padding: 0.7rem 1.25rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .toggle-cities-btn i {
        color: var(--accent-color-start);
        font-size: 0.85rem;
        opacity: 0.8;
    }

    .toggle-cities-btn:hover,
    .toggle-cities-btn:focus-visible {
        background: rgba(var(--accent-color-start-rgb), 0.08);
        border-color: rgba(var(--accent-color-start-rgb), 0.3);
        color: var(--text-color);
        outline: none;
    }

    .toggle-cities-btn:hover i,
    .toggle-cities-btn:focus-visible i {
        opacity: 1;
    }

    @media (max-width: 640px) {
        .layout-grid {
            grid-template-columns: 1fr;
        }
        
        .cities-list {
            grid-template-columns: repeat(2, 1fr) !important;
        }

        .tabs-scroll {
            border-radius: 999px;
            width: auto;
            margin-left: 0;
            padding: 0.4rem;
        }
    }

    /* Particles background (same as home hero) */
    .locations-hero {
        position: relative;
        overflow: hidden;
    }
    .locations-hero #particles-js {
        position: absolute;
        inset: 0;
        z-index: 0;
    }
</style>

<!-- Фоновые частицы (как на главной) -->
<script is:inline src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js" defer></script>
<script>
    import '../../../scripts/particles';
</script>
