---
import TrustPageShell from '../../components/TrustPageShell.astro';
import AccordionItem from '../../components/AccordionItem.astro';
import { TRUST_PAGES } from '../../data/trust-pages';
import { services, servicePath, type Lang } from '../../data/services';
import { useTranslations } from '../../i18n/utils';

export const prerender = true;

export async function getStaticPaths() {
	return [{ params: { lang: 'ru' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const currentLang = (lang === 'en' ? 'en' : 'ru') as Lang;
const meta = TRUST_PAGES.faq;
const t = useTranslations(currentLang);

// Общие вопросы — из единого i18n (те же тексты, что в секции #faq)
const faqPairs = [
	['faq_q1', 'faq_a1'],
	['faq_q2', 'faq_a2'],
	['faq_q3', 'faq_a3'],
	['faq_q4', 'faq_a4'],
	['faq_q5', 'faq_a5'],
] as const;
const faqs = faqPairs.map(([q, a]) => ({ q: t(q), a: t(a) }));

const siteBase = 'https://avpdev.com';
const schema = [
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		inLanguage: currentLang === 'ru' ? 'ru-RU' : 'en-US',
		mainEntity: faqs.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: currentLang === 'ru' ? 'Главная' : 'Home',
				item: `${siteBase}/${currentLang}/`,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: meta.crumb[currentLang],
				item: `${siteBase}/${currentLang}/faq/`,
			},
		],
	},
];
---

<TrustPageShell meta={meta} lang={currentLang} schema={schema}>
	<div class="acc-list" data-accordion>
		{faqs.map((f) => (
			<AccordionItem q={f.q} a={f.a} />
		))}
	</div>

	<h2 class="trust-h2">
		{currentLang === 'ru' ? 'Вопросы по услугам' : 'Service-specific questions'}
	</h2>
	<p class="trust-p">
		{currentLang === 'ru'
			? 'На каждой странице услуги — свой блок вопросов: процесс, оплата, гарантия и передача кода.'
			: 'Each service page answers its own questions: process, payment, warranty and code handover.'}
	</p>
	<ul class="trust-links">
		{services.map((s) => (
			<li>
				<a href={servicePath(s.id, currentLang)}>{s.schema.serviceName[currentLang]}</a>
			</li>
		))}
	</ul>
</TrustPageShell>
