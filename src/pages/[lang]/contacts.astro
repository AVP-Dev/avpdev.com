---
import TrustPageShell from '../../components/TrustPageShell.astro';
import Contact from '../../components/sections/Contact.astro';
import { TRUST_PAGES } from '../../data/trust-pages';
import type { Lang } from '../../data/services';
import { useTranslations } from '../../i18n/utils';

export const prerender = true;

export async function getStaticPaths() {
	return [{ params: { lang: 'ru' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params;
const currentLang = (lang === 'en' ? 'en' : 'ru') as Lang;
const meta = TRUST_PAGES.contacts;
const t = useTranslations(currentLang);

const channels = [
	{
		name: 'Telegram',
		value: '@AVP_Dev',
		href: 'https://t.me/AVP_Dev',
		icon: 'fa-brands fa-telegram',
	},
	{
		name: 'WhatsApp',
		value: '+375 29 121-73-71',
		href: 'https://wa.me/375291217371',
		icon: 'fa-brands fa-whatsapp',
	},
	{
		name: 'Email',
		value: 'contact@avpdev.com',
		href: 'mailto:contact@avpdev.com',
		icon: 'fa-solid fa-envelope',
	},
	{
		name: 'GitHub',
		value: 'github.com/AVP-Dev',
		href: 'https://github.com/AVP-Dev',
		icon: 'fa-brands fa-github',
	},
	{
		name: 'LinkedIn',
		value: 'linkedin.com/in/avp-dev',
		href: 'https://www.linkedin.com/in/avp-dev/',
		icon: 'fa-brands fa-linkedin-in',
	},
];

const siteBase = 'https://avpdev.com';
const schema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: currentLang === 'ru' ? 'Главная' : 'Home',
			item: `${siteBase}/${currentLang}/`,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: meta.crumb[currentLang],
			item: `${siteBase}/${currentLang}/contacts/`,
		},
	],
};
---

<TrustPageShell meta={meta} lang={currentLang} schema={schema} hideContact>
	<address class="channels">
		{channels.map((c) => (
			<a
				class="channel-card"
				href={c.href}
				target={c.href.startsWith('http') ? '_blank' : undefined}
				rel={c.href.startsWith('http') ? 'noopener' : undefined}
			>
				<i class={c.icon} aria-hidden="true"></i>
				<span class="channel-name">{c.name}</span>
				<span class="channel-value">{c.value}</span>
			</a>
		))}
	</address>
	<p class="trust-p trust-gap">{t('contact_p')}</p>
	<Contact />
</TrustPageShell>
