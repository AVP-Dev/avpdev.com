<script is:inline src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js" defer></script>
<script>
    import '../../../scripts/particles';
</script>

<script>
    document.addEventListener("astro:page-load", () => {
        const form = document.getElementById("brief-form") as HTMLFormElement;
        if (!form) return;

        // --- Progress bar, autosave, clear-draft, contacts validation ---
        const currentLang = (window.location.pathname.split('/').filter(Boolean)[0] === 'ru' ? 'ru' : 'en') as 'ru' | 'en';
        const progressFill = document.getElementById("brief-progress-fill") as HTMLElement | null;
        const progressText = document.getElementById("brief-progress-text") as HTMLElement | null;
        const formBlocks = Array.from(form.querySelectorAll(".form-block")) as HTMLElement[];
        const updateProgress = (idx: number) => {
            const pct = Math.round((idx / 10) * 100);
            if (progressFill) progressFill.style.width = pct + "%";
            if (progressText) {
                progressText.textContent = currentLang === 'ru' ? `Шаг ${idx} из 10 — ${pct}%` : `Step ${idx} of 10 — ${pct}%`;
            }
        };
        if (formBlocks.length && progressFill) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const idx = formBlocks.indexOf(entry.target as HTMLElement) + 1;
                        if (idx > 0) updateProgress(idx);
                    }
                });
            }, { root: null, rootMargin: "-40% 0px -40% 0px", threshold: 0.1 });
            formBlocks.forEach((block) => observer.observe(block));
            form.addEventListener("focusin", (e) => {
                const target = e.target as HTMLElement;
                const block = target.closest(".form-block") as HTMLElement | null;
                if (block) {
                    const idx = formBlocks.indexOf(block) + 1;
                    if (idx > 0) updateProgress(idx);
                }
            });
        }

        // localStorage autosave key `brief-draft-${lang}`
        const draftKey = `brief-draft-${currentLang}`;
        const serialize = () => {
            const data: Record<string, any> = {};
            const fd = new FormData(form);
            const keys = new Set<string>();
            for (const [k] of (fd as any).entries()) keys.add(k as string);
            keys.forEach((key) => {
                const vals = fd.getAll(key);
                if (vals.length > 1) data[key] = vals;
                else data[key] = vals[0];
            });
            Array.from(form.elements).forEach((el: any) => {
                if (!el.name) return;
                if (el.type === "checkbox" || el.type === "radio") return;
                if (!(el.name in data)) data[el.name] = el.value;
            });
            try { localStorage.setItem(draftKey, JSON.stringify(data)); } catch {}
        };
        const restore = () => {
            try {
                const raw = localStorage.getItem(draftKey);
                if (!raw) return;
                const data = JSON.parse(raw);
                Object.entries(data).forEach(([key, value]) => {
                    const els = form.querySelectorAll(`[name="${key}"]`);
                    if (!els.length) return;
                    els.forEach((el: any) => {
                        if (el.type === "checkbox" || el.type === "radio") {
                            if (Array.isArray(value)) {
                                el.checked = (value as any[]).includes(el.value);
                            } else {
                                if (el.value === value) el.checked = true;
                                if (value === "on" && el.type === "checkbox") el.checked = true;
                            }
                        } else {
                            el.value = value as string;
                        }
                        if (el.type === "checkbox" && el.value === "other" && el.checked) {
                            const otherInputDiv = el.closest(".checkbox-group")?.nextElementSibling as HTMLElement | null;
                            if (otherInputDiv && otherInputDiv.classList.contains("other-input")) {
                                otherInputDiv.style.display = "block";
                            }
                        }
                    });
                });
            } catch {}
        };
        restore();
        form.addEventListener("input", serialize);
        form.addEventListener("change", serialize);

        // Кнопка "Очистить черновик" рядом с submit
        const submitContainer = form.querySelector(".form-submit-container") as HTMLElement | null;
        let clearBtn = document.getElementById("brief-clear-draft") as HTMLButtonElement | null;
        if (submitContainer && !clearBtn) {
            clearBtn = document.createElement("button");
            clearBtn.type = "button";
            clearBtn.id = "brief-clear-draft";
            clearBtn.textContent = currentLang === 'ru' ? "Очистить черновик" : "Clear draft";
            (clearBtn as HTMLElement).style.marginLeft = "12px";
            clearBtn.className = "cta-button cta-button--secondary";
            (clearBtn as HTMLElement).style.background = "transparent";
            (clearBtn as HTMLElement).style.border = "1px solid var(--border-color)";
            (clearBtn as HTMLElement).style.color = "var(--text-secondary-color)";
            submitContainer.appendChild(clearBtn);
        }
        if (clearBtn) {
            clearBtn.addEventListener("click", () => {
                try { localStorage.removeItem(draftKey); } catch {}
                form.reset();
                form.querySelectorAll<HTMLElement>(".other-input").forEach((el) => (el.style.display = "none"));
                updateProgress(1);
                form.querySelectorAll(".error-field").forEach((el) => el.classList.remove("error-field"));
                const hiddenErrors = form.querySelectorAll(".error-text:not(.hidden)");
                hiddenErrors.forEach((el) => el.classList.add("hidden"));
                const consentErr = document.getElementById("consent-error");
                if (consentErr) consentErr.classList.add("hidden");
                const siteTypeErr = document.getElementById("site-type-error");
                if (siteTypeErr) siteTypeErr.classList.add("hidden");
                const siteTypeGroup = document.getElementById("site-type-group");
                if (siteTypeGroup) siteTypeGroup.classList.remove("error-field");
            });
        }

        // --- Logic for showing/hiding "Other" field ---
        const otherCheckboxes = form.querySelectorAll<HTMLInputElement>(
            'input[type="checkbox"][value="other"]',
        );
        otherCheckboxes.forEach((checkbox) => {
            const otherInputDiv = checkbox.closest(".checkbox-group")
                ?.nextElementSibling as HTMLElement | null;
            if (
                otherInputDiv &&
                otherInputDiv.classList.contains("other-input")
            ) {
                checkbox.addEventListener("change", () => {
                    otherInputDiv.style.display = checkbox.checked
                        ? "block"
                        : "none";
                });
            }
        });

        // --- Form submission logic ---
        const submitButton = document.getElementById(
            "submit-button",
        ) as HTMLButtonElement;
        const spinner = document.getElementById("form-spinner") as HTMLElement;
        const consentCheckbox = document.getElementById(
            "legal-consent",
        ) as HTMLInputElement;

        const consentError = document.getElementById(
            "consent-error",
        ) as HTMLElement;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            // Reset error fields
            form.querySelectorAll(".error-field").forEach((el) =>
                el.classList.remove("error-field"),
            );
            if (consentError) consentError.classList.add("hidden");

            let isValid = true;
            form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
                "[required]",
            ).forEach((field) => {
                if (!field.value.trim() && field.type !== "checkbox") {
                    field.classList.add("error-field");
                    isValid = false;
                }
            });

            // --- Validate: at least one project type selected (new multi-select) ---
            const siteTypeGroup = document.getElementById("site-type-group") as HTMLElement | null;
            const siteTypeError = document.getElementById("site-type-error") as HTMLElement | null;
            if (siteTypeGroup) siteTypeGroup.classList.remove("error-field");
            if (siteTypeError) siteTypeError.classList.add("hidden");
            const siteTypeChecked = form.querySelectorAll<HTMLInputElement>('input[name="site_type"]:checked');
            if (siteTypeChecked.length === 0) {
                if (siteTypeGroup) siteTypeGroup.classList.add("error-field");
                if (siteTypeError) siteTypeError.classList.remove("hidden");
                isValid = false;
            }

            // --- Validate contacts (any valid input: Telegram, Phone, Email, etc.) ---
            const contactsInput = form.querySelector<HTMLInputElement>('#contacts');
            if (contactsInput) {
                const val = contactsInput.value.trim();
                if (val.length < 2) {
                    contactsInput.classList.add("error-field");
                    isValid = false;
                }
            }

            if (!consentCheckbox.checked) {
                consentCheckbox.classList.add("error-field");
                if (consentError) consentError.classList.remove("hidden");
                isValid = false;
            }

            if (!isValid) {
                (
                    form.querySelector(".error-field") as HTMLElement
                )?.scrollIntoView({ behavior: "smooth", block: "center" });
                return;
            }

            // Turnstile validation
            const turnstileResponse = form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement;
            if (!turnstileResponse || !turnstileResponse.value) {
                alert((document.getElementById("brief-form") as HTMLFormElement)?.dataset.turnstileAlert || "");
                return;
            }

            submitButton.style.display = "none";
            spinner.style.display = "block";

            const formData = new FormData(form);

            // Collect arrays for multiple-choice checkboxes (site_type теперь multi-select)
            const siteTypes = formData.getAll("site_type");
            const features = formData.getAll("features");
            const support = formData.getAll("support");

            // Build data object from FormData, excluding arrays we'll add manually
            const data: Record<string, any> = {};
            for (const [key, value] of formData.entries()) {
                if (key !== "features" && key !== "support" && key !== "site_type") {
                    // Only take the first value for non-array fields
                    if (!data[key]) {
                        data[key] = value;
                    }
                }
            }

            // Add arrays explicitly — site_type: string если 1, массив если несколько (поддерживает оба варианта в схеме)
            if (siteTypes.length === 1) data.site_type = siteTypes[0];
            else if (siteTypes.length > 1) data.site_type = siteTypes;
            if (features.length > 0) data.features = features;
            if (support.length > 0) data.support = support;

            // CRITICAL: Convert checkbox from "on"/undefined to boolean
            data.consent = formData.get("consent") === "on";

            // Add UTM Data if available
            if (typeof window !== 'undefined' && typeof window.getUtmParams === 'function') {
                const utms = window.getUtmParams();
                if (utms) {
                    Object.assign(data, utms);
                }
            }

            if (import.meta.env.DEV) console.log("📤 Sending brief data:", data);

            try {
                const response = await fetch("/api/sendBrief/", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(data),
                });

                if (response.ok) {
                    if (typeof window !== 'undefined') {
                        if (window.gtag) window.gtag('event', 'generate_lead', { form_name: 'brief_form' });
                        if (window.ym) window.ym(107147089, 'reachGoal', 'form_submit');
                    }
                    
                    document.dispatchEvent(
                        new CustomEvent("modal:open", {
                            detail: { modalId: "success-modal" },
                        }),
                    );
                    form.reset();
                    try { localStorage.removeItem(draftKey); } catch {}
                    updateProgress(1);
                    form.querySelectorAll<HTMLElement>(".other-input").forEach((el) => (el.style.display = "none"));
                } else {
                    if (response.status === 400) {
                        const resData = await response.json();
                        if (resData.errors) {
                            Object.keys(resData.errors).forEach((key) => {
                                const input = form.querySelector(
                                    `[name="${key}"]`,
                                );
                                if (input) {
                                    input.classList.add("error-field");
                                }
                            });

                            const firstError =
                                form.querySelector(".error-field");
                            if (firstError) {
                                firstError.scrollIntoView({
                                    behavior: "smooth",
                                    block: "center",
                                });
                            }
                        }
                    } else {
                        throw new Error("Server response was not ok.");
                    }
                }
            } catch (error) {
                console.error("Brief sending error:", error);
                document.dispatchEvent(
                    new CustomEvent("modal:open", {
                        detail: { modalId: "error-modal" },
                    }),
                );
            } finally {
                submitButton.style.display = "block";
                spinner.style.display = "none";
                // Reset Turnstile on error/success
                if (window.turnstile) {
                    window.turnstile.reset();
                }
            }
        });
    });
</script>
