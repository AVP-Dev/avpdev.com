---
// src/pages/[lang]/brief/index.astro
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SuccessModal from "../../../components/modals/SuccessModal.astro";
import ErrorModal from "../../../components/modals/ErrorModal.astro";
import { useTranslations } from "../../../i18n/utils";

export const prerender = true;

export async function getStaticPaths() {
    return [{ params: { lang: "en" } }, { params: { lang: "ru" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as "en" | "ru");
---

<BaseLayout title="brief_page_title" description="brief_page_desc">
    <div id="brief-progress" class="brief-progress"> <div class="brief-progress__bar"><div class="brief-progress__fill" id="brief-progress-fill"></div></div> <div class="brief-progress__text" id="brief-progress-text">{lang === 'ru' ? 'Шаг 1 из 10 — 10%' : 'Step 1 of 10 — 10%'}</div> </div>
    <section id="brief-form-section" class="case-study-header">
        <div id="particles-js"></div>
        <div class="container container-narrow">
            <h1 class="section-title" set:html={t("brief_title")} />
            <p class="section-subtitle">{t("brief_subtitle")}</p>

            <form id="brief-form" class="brief-form" novalidate data-turnstile-alert={t("brief_alert_turnstile")}>
                <fieldset class="form-block fade-in">
                    <legend>{t("brief_step_1")}</legend>
                    <div class="form-group">
                        <label for="company_name"
                            >{t("brief_company_name")}</label
                        >
                        <input
                            type="text"
                            id="company_name"
                            name="company_name"
                            class="form-control"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label for="contacts">{t("brief_contacts")}</label>
                        <input
                            type="text"
                            id="contacts"
                            name="contacts"
                            class="form-control"
                            required
                        />
                    </div>
                    <div class="form-group">
                        <label>{t("brief_contact_method")}</label>
                        <div class="radio-group">
                            <label
                                ><input
                                    type="radio"
                                    name="preferred_contact"
                                    value="Telegram"
                                    checked
                                /><span>Telegram</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="preferred_contact"
                                    value="WhatsApp"
                                /><span>WhatsApp</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="preferred_contact"
                                    value="Email"
                                /><span>Email</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="preferred_contact"
                                    value="Call"
                                /><span
                                    >{t("brief_contact_call")}</span
                                ></label
                            >
                        </div>
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 100ms;"
                >
                    <legend>{t("brief_step_2")}</legend>
                    <div class="form-group">
                        <label for="business_sphere"
                            >{t("brief_business_sphere")}</label
                        >
                        <textarea
                            id="business_sphere"
                            name="business_sphere"
                            class="form-control"
                            rows="3"
                            required></textarea>
                    </div>
                    <div class="form-group">
                        <label for="current_site"
                            >{t("brief_current_site")}</label
                        >
                        <input
                            type="text"
                            id="current_site"
                            name="current_site"
                            class="form-control"
                            placeholder={t("brief_placeholder_url")}
                        />
                    </div>
                    <div class="form-group">
                        <label for="competitors">{t("brief_competitors")}</label
                        >
                        <textarea
                            id="competitors"
                            name="competitors"
                            class="form-control"
                            rows="2"
                            placeholder={t("brief_competitors_placeholder")}
                        ></textarea>
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 200ms;"
                >
                    <legend>{t("brief_step_3")}</legend>
                    <div class="form-group">
                        <label>{t("brief_goals_title")}</label>
                        <div class="radio-group-vertical">
                            <label
                                ><input
                                    type="radio"
                                    name="project_goal"
                                    value="Selling goods or services online"
                                    checked
                                /><span>{t("brief_goal_1")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="project_goal"
                                    value="Lead generation"
                                /><span>{t("brief_goal_2")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="project_goal"
                                    value="Corporate presence"
                                /><span>{t("brief_goal_3")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="project_goal"
                                    value="Information portal or blog"
                                /><span>{t("brief_goal_4")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="project_goal"
                                    value="Internal process automation"
                                /><span>{t("brief_goal_5")}</span></label
                            >
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="success_metrics"
                            >{t("brief_success_metrics")}</label
                        >
                        <textarea
                            id="success_metrics"
                            name="success_metrics"
                            class="form-control"
                            rows="2"></textarea>
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 300ms;"
                >
                    <legend>{t("brief_step_4")}</legend>
                    <div class="form-group">
                        <label for="target_audience"
                            >{t("brief_target_audience")}</label
                        >
                        <textarea
                            id="target_audience"
                            name="target_audience"
                            class="form-control"
                            rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="user_action">{t("brief_user_action")}</label
                        >
                        <input
                            type="text"
                            id="user_action"
                            name="user_action"
                            class="form-control"
                            placeholder={t("brief_user_action_placeholder")}
                        />
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 400ms;"
                >
                    <legend>{t("brief_step_5")}</legend>
                    <div class="form-group">
                        <label>{t("brief_site_type")}</label>
                        <p class="form-hint">{t("brief_site_type_hint")}</p>
                        <div class="checkbox-group" id="site-type-group">
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="Website"
                                /><span>{t("brief_site_type_1")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="Online Store"
                                /><span>{t("brief_site_type_2")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="Web Service / SaaS"
                                /><span>{t("brief_site_type_3")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="Telegram Mini App"
                                /><span>{t("brief_site_type_4")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="Bot / Parser"
                                /><span>{t("brief_site_type_5")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="Automation & Integrations"
                                /><span>{t("brief_site_type_6")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="AI Solution"
                                /><span>{t("brief_site_type_7")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="site_type"
                                    value="Need consultation"
                                /><span>{t("brief_site_type_8")}</span></label
                            >
                        </div>
                        <p id="site-type-error" class="error-text hidden" style="margin-top:0.5rem;">{lang === 'ru' ? 'Выберите хотя бы один вариант' : 'Select at least one option'}</p>
                    </div>
                    <div class="form-group">
                        <label>{t("brief_functionality")}</label>
                        <p class="form-hint">{t("brief_functionality_hint")}</p>
                        <div class="checkbox-group">
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="Catalog / Showcase"
                                /><span>{t("brief_feat_1")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="Blog / News / SEO"
                                /><span>{t("brief_feat_2")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="User Account & Roles"
                                /><span>{t("brief_feat_3")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="Cart & Online Payments"
                                /><span>{t("brief_feat_4")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="Calculator / Configurator"
                                /><span>{t("brief_feat_5")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="Multilingual"
                                /><span>{t("brief_feat_6")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="Integrations"
                                /><span>{t("brief_feat_7")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="Bot & Notifications"
                                /><span>{t("brief_feat_8")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="AI Features"
                                /><span>{t("brief_feat_9")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="features"
                                    value="other"
                                /><span>{t("brief_feat_other")}</span></label
                            >
                        </div>
                        <div
                            class="form-group other-input"
                            style="display: none;"
                        >
                            <input
                                type="text"
                                name="features_other"
                                class="form-control"
                                placeholder={t("brief_feat_other_placeholder")}
                            />
                        </div>
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 500ms;"
                >
                    <legend>{t("brief_step_6")}</legend>
                    <div class="form-group">
                        <label>{t("brief_identity")}</label>
                        <div class="radio-group">
                            <label
                                ><input
                                    type="radio"
                                    name="brand_identity"
                                    value="Yes, have everything"
                                    checked
                                /><span>{t("brief_identity_1")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="brand_identity"
                                    value="Only logo"
                                /><span>{t("brief_identity_2")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="brand_identity"
                                    value="No, need development"
                                /><span>{t("brief_identity_3")}</span></label
                            >
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="design_examples"
                            >{t("brief_design_examples")}</label
                        >
                        <textarea
                            id="design_examples"
                            name="design_examples"
                            class="form-control"
                            rows="2"
                            placeholder={t("brief_design_placeholder")}
                        ></textarea>
                    </div>
                    <div class="form-group">
                        <label>{t("brief_content")}</label>
                        <div class="radio-group">
                            <label
                                ><input
                                    type="radio"
                                    name="content_provider"
                                    value="We have ready content"
                                    checked
                                /><span>{t("brief_content_1")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="content_provider"
                                    value="We will prepare content"
                                /><span>{t("brief_content_2")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="content_provider"
                                    value="Need help with content"
                                /><span>{t("brief_content_3")}</span></label
                            >
                        </div>
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 600ms;"
                >
                    <legend>{t("brief_step_7")}</legend>
                    <div class="form-group">
                        <label>{t("brief_domain_hosting")}</label>
                        <div class="radio-group">
                            <label
                                ><input
                                    type="radio"
                                    name="hosting_domain"
                                    value="Yes, have"
                                    checked
                                /><span>{t("brief_domain_hosting_1")}</span
                                ></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="hosting_domain"
                                    value="No, need help"
                                /><span>{t("brief_domain_hosting_2")}</span
                                ></label
                            >
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="integrations"
                            >{t("brief_integrations")}</label
                        >
                        <textarea
                            id="integrations"
                            name="integrations"
                            class="form-control"
                            rows="2"
                            placeholder={t("brief_integrations_placeholder")}
                        ></textarea>
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 700ms;"
                >
                    <legend>{t("brief_step_8")}</legend>
                    <div class="form-group">
                        <label>{t("brief_budget")}</label>
                        <div class="radio-group-vertical">
                            <label
                                ><input
                                    type="radio"
                                    name="budget"
                                    value="Up to $1000"
                                    checked
                                /><span>{t("brief_budget_1")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="budget"
                                    value="$1000 - $3000"
                                /><span>{t("brief_budget_2")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="budget"
                                    value="$3000 - $7000"
                                /><span>{t("brief_budget_3")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="budget"
                                    value="$7000 - $15000"
                                /><span>{t("brief_budget_4")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="budget"
                                    value="Over $15000"
                                /><span>{t("brief_budget_5")}</span></label
                            >
                            <label
                                ><input
                                    type="radio"
                                    name="budget"
                                    value="To be discussed"
                                /><span>{t("brief_budget_6")}</span></label
                            >
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="budget_other">{t("brief_budget_other_label")}</label>
                        <input
                            type="text"
                            id="budget_other"
                            name="budget_other"
                            class="form-control"
                            placeholder={t("brief_budget_other_placeholder")}
                        />
                    </div>
                    <div class="form-group">
                        <label for="deadline">{t("brief_deadline")}</label>
                        <input
                            type="text"
                            id="deadline"
                            name="deadline"
                            class="form-control"
                        />
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 900ms;"
                >
                    <legend>{t("brief_step_9")}</legend>
                    <div class="form-group">
                        <label for="additional_info"
                            >{t("brief_additional_info")}</label
                        >
                        <textarea
                            id="additional_info"
                            name="additional_info"
                            class="form-control"
                            rows="4"></textarea>
                    </div>
                </fieldset>

                <fieldset
                    class="form-block fade-in"
                    style="transition-delay: 900ms;"
                >
                    <legend>{t("brief_step_10")}</legend>
                    <div class="form-group">
                        <label>{t("brief_support_title")}</label>
                        <div class="checkbox-group">
                            <label
                                ><input
                                    type="checkbox"
                                    name="support"
                                    value="Technical support"
                                /><span>{t("brief_support_1")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="support"
                                    value="Further development"
                                /><span>{t("brief_support_2")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="support"
                                    value="Not required at this stage"
                                /><span>{t("brief_support_3")}</span></label
                            >
                            <label
                                ><input
                                    type="checkbox"
                                    name="support"
                                    value="Hard to answer"
                                /><span>{t("brief_support_4")}</span></label
                            >
                        </div>
                    </div>
                </fieldset>

                <div class="form-footer centered">
                    <div class="checkbox-wrapper">
                        <input
                            type="checkbox"
                            id="legal-consent"
                            name="consent"
                            class="custom-checkbox"
                            required
                        />
                        <label for="legal-consent" class="checkbox-label">
                            {t("form_consent_prefix")}{" "}
                            <a href={`/${lang}/legal/public-offer/`}>
                                {t("form_consent_offer")}
                            </a>{" "}
                            {t("form_consent_and")}{" "}
                            <a href={`/${lang}/legal/privacy-policy/`}>
                                {t("form_consent_data")}
                            </a>
                            .
                        </label>
                    </div>

                    <p id="consent-error" class="error-text hidden">
                        {t("form_consent_required")}
                    </p>
                </div>

                <!-- Turnstile Widget Container -->
                <div class="turnstile-container">
                    <div class="cf-turnstile" data-sitekey={String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "1x00000000000000000000AA")} data-theme="dark"></div>
                </div>

                <div class="form-submit-container">
                    <button id="submit-button" type="submit" class="cta-button"
                        >{t("form_button")}</button
                    >
                    <div
                        id="form-spinner"
                        class="spinner"
                        style="display: none;"
                    >
                    </div>
                </div>
            </form>
        </div>
    </section>

    <SuccessModal />
    <ErrorModal />
</BaseLayout>

<style>
/* Стили для страницы брифа */
.brief-form {
    max-width: 800px;
    margin: 3rem auto 0;
    text-align: left;
    background: var(--primary-color);
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3rem);
    border-radius: 24px;
    border: 1px solid var(--border-color);
    box-shadow: var(--card-shadow);
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
}

.centered {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.form-footer.centered {
    margin: 2.5rem 0;
}

.dark-theme .brief-form {
    box-shadow:
        var(--card-shadow),
        inset 0 1px 1px rgba(255, 255, 255, 0.05);
}

.form-block {
    border: none;
    padding: 0;
    margin: 0 0 2.5rem 0;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2.5rem;
}

.form-block:last-of-type {
    border-bottom: none;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
}

.form-block legend {
    font-size: clamp(1.25rem, 4vw, 1.5rem);
    font-weight: 700;
    margin-bottom: 1.5rem;
    padding: 0;
    color: var(--text-color);
    font-family: var(--font-heading);
}

.form-block .form-group {
    margin-bottom: 1.5rem;
}

.form-hint {
    font-size: 0.88rem;
    color: var(--text-color);
    margin: -0.25rem 0 1rem;
    line-height: 1.5;
    font-weight: 400;
    background: rgba(var(--accent-color-start-rgb), 0.06);
    border-left: 2px solid var(--border-color);
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
}

.error-text.hidden { display: none; }
.error-text {
    color: #ff4d4d;
    font-size: 0.88rem;
    margin-top: 0.25rem;
}
#site-type-group.error-field {
    outline: 1px solid #ff4d4d;
    border-radius: 8px;
    padding: 0.5rem;
}

/* Скрытое поле "Другое" */
.form-group.other-input {
    margin-top: 1rem;
}


.form-block label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 500;
    color: var(--text-secondary-color);
}

.radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    row-gap: 0.8rem;
}

.checkbox-group {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem 1rem;
    justify-content: stretch;
    align-items: start;
}

.checkbox-group label {
    justify-content: flex-start;
    text-align: left;
    width: 100%;
}

.radio-group-vertical {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

/* --- СТИЛИ ДЛЯ RADIO И CHECKBOX --- */

/* Контейнер label */
.radio-group label,
.checkbox-group label,
.radio-group-vertical label {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    position: relative;
    -webkit-tap-highlight-color: transparent;
    min-height: 1.5em;
    /* Гарантируем высоту для выравнивания */
}

.checkbox-group label {
    display: flex;
}

/* Скрываем стандартный input */
.radio-group input,
.checkbox-group input,
.radio-group-vertical input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
}

/* Текст внутри label */
.radio-group span,
.checkbox-group span,
.radio-group-vertical span {
    color: var(--text-color);
    font-weight: 400;
    padding-left: 2em;
}

/* Кастомный элемент (основа) - ::before */
.radio-group span::before,
.checkbox-group span::before,
.radio-group-vertical span::before {
    content: '';
    position: absolute;
    left: 0;
    /* Точное вертикальное центрирование с calc() */
    top: calc(50% - 0.625em);
    height: 1.25em;
    width: 1.25em;
    border: 2px solid var(--border-color);
    background-color: var(--bg-color);
    transition: border-color 0.2s, background-color 0.2s;
    box-sizing: border-box;
}

/* Стиль для radio (круглый) */
.radio-group span::before,
.radio-group-vertical span::before {
    border-radius: 50%;
}

/* Стиль для checkbox (квадратный) */
.checkbox-group span::before {
    border-radius: 4px;
}

/* Состояние при наведении */
.radio-group label:hover span::before,
.checkbox-group label:hover span::before,
.radio-group-vertical label:hover span::before {
    border-color: var(--accent-color-start);
}

/* Состояние при выборе (checked) */
input:checked+span::before {
    border-color: var(--accent-color-start);
    background-color: var(--accent-color-start);
}

/* Внутренняя точка/галочка (основа) - ::after */
.radio-group span::after,
.checkbox-group span::after,
.radio-group-vertical span::after {
    content: '';
    position: absolute;
    transition: transform 0.15s ease-in-out;
    transform: scale(0);
    box-sizing: border-box;
}

/* Точка для radio - ИСПРАВЛЕНО ЦЕНТРИРОВАНИЕ */
input[type="radio"]+span::after {
    width: 0.6em;
    height: 0.6em;
    background-color: var(--primary-color);
    border-radius: 50%;
    /* Позиционируем от левого края + половина ширины круга - половина ширины точки */
    left: calc(0.625em - 0.3em);
    /* Позиционируем от верха + половина высоты круга - половина высоты точки */
    top: calc(50% - 0.3em);
}

/* Галочка для checkbox */
input[type="checkbox"]+span::after {
    width: 0.35em;
    height: 0.7em;
    border: solid var(--primary-color);
    border-width: 0 3px 3px 0;
    left: 0.45em;
    top: calc(50% - 0.45em);
    transform: rotate(45deg) scale(0);
}

/* Показываем точку/галочку при выборе */
input:checked+span::after {
    transform: rotate(0) scale(1);
}

input[type="checkbox"]:checked+span::after {
    transform: rotate(45deg) scale(1);
}

