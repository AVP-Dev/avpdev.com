---
// src/components/ServicePageContent.astro
// Единый рендер страницы услуги: данные берёт из src/data/services.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AccordionItem from './AccordionItem.astro';
import Hero from './sections/Hero.astro';
import Contact from './sections/Contact.astro';
import ServicePricing from './sections/ServicePricing.astro';
import PortfolioCard from './PortfolioCard.astro';
import { FACTS, servicePath, type ServicePageData, type Lang } from '../data/services';
import { getServiceProjects } from '../utils/related';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';

export interface Props {
    service: ServicePageData;
    lang: Lang;
}

const { service, lang } = Astro.props;

const t = useTranslations(lang);
const hero = service.hero[lang];
const section = service.section[lang];
const features = service.features[lang];
const faqs = service.faqs[lang];
const faqHeading = service.faqHeading[lang];
const faqSubtitle = service.faqSubtitle[lang];
const pricing = service.pricing[lang];

const providerName = t('author_name');

// Связка «услуга → кейсы» (перелинковка каталога, детерминированная)
const allProjects = await getCollection('projects', ({ id }) => id.startsWith(`${lang}/`));
const serviceCases = getServiceProjects(service.id, allProjects, 2);

// Offer с ценой: парсим число из tier.value («от $400» → 400 USD).
// Фактично — дословно соответствует отображаемым ценам на странице.
const tierOffers = pricing.tiers.flatMap((tier) => {
  const digits = tier.value.replace(/[^0-9]/g, '');
  const base: Record<string, unknown> = {
    "@type": "Offer",
    name: tier.label,
    description: tier.note ? `${tier.value}. ${tier.note}` : tier.value,
  };
  if (digits) {
    base.price = digits;
    base.priceCurrency = 'USD';
  }
  return [base];
});

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "name": service.schema.serviceName[lang],
      "description": service.seoDescription[lang],
      "provider": {
        "@type": "Person",
        "name": providerName
      },
      "inLanguage": lang === 'ru' ? 'ru-RU' : 'en-US',
      "areaServed": "Worldwide",
      "offers": tierOffers,
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": service.schema.catalogName[lang],
        "itemListElement": features.map(f => ({
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": f.title,
            "description": f.desc
          }
        }))
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": lang === 'ru' ? 'Главная' : 'Home',
          "item": `https://avpdev.com/${lang}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": lang === 'ru' ? 'Услуги' : 'Services',
          "item": `https://avpdev.com/${lang}/${lang === 'ru' ? 'uslugi' : 'services'}/`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": service.schema.serviceName[lang],
          "item": `https://avpdev.com${servicePath(service.id, lang)}`
        }
      ]
    }
  ]
};
---

<BaseLayout title={service.seoTitle[lang]} description={service.seoDescription[lang]} isTranslationKey={false} schema={schema}>
  <Hero title={hero.title} subtitle={hero.subtitle} variant="services">
    <Breadcrumbs slot="crumbs" items={[
      { name: t('breadcrumb_home'), href: `/${lang}/` },
      { name: lang === 'ru' ? 'Услуги' : 'Services', href: `/${lang}/${lang === 'ru' ? 'uslugi' : 'services'}/` },
      { name: service.schema.serviceName[lang] },
    ]} />
  </Hero>

  <section class="services-info">
    <div class="container">
      <div class="section-content-split">
        <div class="text-content">
          <span class="section-label">{section.label}</span>
          <h2 class="section-title-left">{section.title}</h2>
          <p class="section-description">{section.description}</p>

          <div class="feature-list">
            {features.map((f) => (
              <div class="feature-item">
                <div class="feature-icon-glass">
                  <i class={f.icon}></i>
                </div>
                <div class="feature-text">
                  <h3>{f.title}</h3>
                  <p>{f.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="visual-content">
          <div class="service-graphic-box-premium">
            <div class="graphic-glow"></div>
            <i class={`${section.icon} graphic-icon-main`}></i>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ServicePricing title={t('pricing_title')} tiers={pricing.tiers} facts={pricing.facts} note={FACTS.pricingNote[lang]} />

  {serviceCases.length > 0 && (
    <section class="service-cases">
      <div class="container">
        <h2 class="section-title">{lang === 'ru' ? 'Кейсы по услуге' : 'Related case studies'}</h2>
        <div class="service-cases-grid">
          {serviceCases.map((p) => (
            <PortfolioCard
              id={0 as any}
              tags={p.data.stack as any}
              img={p.data.heroImage}
              titleKey={p.data.titleKey as any}
              link={`/${lang}/project/${p.id.replace(/^ru\/|^en\//, '').replace(/\.mdx?$/, '')}/`}
              techStack={p.data.content.techStack}
              category={p.data.category as any}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="faq-section">
    <div class="container">
      <div class="faq-header">
        <h2 class="section-title">{faqHeading}</h2>
        <p class="section-subtitle">{faqSubtitle}</p>
      </div>
      <div class="acc-list" data-accordion>
        {faqs.map((faq) => (
          <AccordionItem q={faq.q} a={faq.a} />
        ))}
      </div>
    </div>
  </section>

  <Contact />
</BaseLayout>

<style>
  .services-info {
    padding: 140px 0;
    background-color: var(--bg-color);
  }

  .section-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--accent-color);
    margin-bottom: 1rem;
  }

  .section-title-left {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: var(--text-color);
  }

  .section-content-split {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 6rem;
    align-items: center;
  }

  .section-description {
    font-size: 1.15rem;
    color: var(--text-color);
    opacity: 0.85;
    margin-bottom: 4rem;
    line-height: 1.6;
    max-width: 600px;
  }

  .feature-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .feature-item {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .feature-icon-glass {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(8px);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color);
    font-size: 1.5rem;
    transition: all 0.3s ease;
  }

  .feature-item:hover .feature-icon-glass {
    background: rgba(var(--accent-color-start-rgb), 0.1);
    border-color: rgba(var(--accent-color-start-rgb), 0.3);
    transform: translateY(-5px);
  }

  .feature-text h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-color);
  }

  .feature-text p {
    color: var(--text-color);
    opacity: 0.75;
    font-size: 1rem;
    line-height: 1.7;
    font-weight: 400;
  }

  .visual-content {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .service-graphic-box-premium {
    width: 100%;
    aspect-ratio: 1;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .graphic-glow {
    position: absolute;
    width: 120%;
    height: 120%;
    background: radial-gradient(circle, rgba(var(--accent-color-start-rgb), 0.1) 0%, transparent 60%);
    z-index: 0;
  }

  .graphic-icon-main {
    font-size: 10rem;
    color: var(--accent-color);
    filter: drop-shadow(0 0 30px rgba(var(--accent-color-start-rgb), 0.3));
    z-index: 1;
  }

  .faq-section {
    padding: 140px 0;
    background-color: var(--primary-color);
  }

  .faq-header {
    margin-bottom: 5rem;
  }

  @media (max-width: 1200px) {
    .section-content-split {
      gap: 3rem;
    }
  }

  @media (max-width: 992px) {
    .section-content-split {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .section-title-left {
      text-align: center;
    }
    .section-description {
      margin-left: auto;
      margin-right: auto;
    }
    .feature-item {
      text-align: left;
    }
    .section-label {
      letter-spacing: 0.1em;
    }
    .visual-content {
      display: none;
    }
  }
</style>
