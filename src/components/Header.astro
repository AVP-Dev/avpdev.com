---
// src/components/Header.astro
import { Image } from "astro:assets";
import logo from "../assets/images/logo.svg";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { getRelativeLocaleUrl } from 'astro:i18n';
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Icon from "./Icon.astro";
import RetroAudioPlayer from "./RetroAudioPlayer.astro";
import { NAV_ORDER, servicePath, NAV_LABEL_KEYS } from "../data/services";

interface Props {
    translationSlug?: string;
}

const { translationSlug } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homePath = `/${lang}/`;

// Иконки пунктов меню услуг (порядок — NAV_ORDER из services.ts)
const navIcons: Record<string, string> = {
    websites: 'fa-solid fa-laptop-code',
    shop: 'fa-solid fa-cart-shopping',
    tma: 'fa-brands fa-telegram',
    ai: 'fa-solid fa-brain',
    bots: 'fa-solid fa-robot',
    saas: 'fa-solid fa-rocket',
};
const navServiceLinks = NAV_ORDER.map((id) => ({
    id,
    icon: navIcons[id],
    labelKey: NAV_LABEL_KEYS[id] as Parameters<typeof t>[0],
}));
---

<header class="site-header">
    <nav class="container">
        <a href={homePath} class="logo" aria-label={t("alt_logo")}>
            <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="logo-img" width="40" height="40">
                <path d="M50 0L0 100H25L50 50L75 100H100L50 0Z" fill="currentColor"/>
                <path d="M50 50L62.5 75L75 50L87.5 75L100 100H75L62.5 75L50 100H25L50 50Z" fill="url(#paint_logo_orange)"/>
                <defs>
                    <linearGradient id="paint_logo_orange" x1="62.5" y1="50" x2="62.5" y2="100" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#FFC837"/>
                        <stop offset="1" stop-color="#FF8C00"/>
                    </linearGradient>
                </defs>
            </svg>
            <span class="logo-text">AVP<span class="gradient-text">dev.com</span></span>
        </a>
        <ul class="nav-links">
            <div class="nav-dropdown">
          <a href={getRelativeLocaleUrl(lang, lang === 'ru' ? 'uslugi' : 'services')} class="nav-dropbtn" aria-haspopup="true" aria-expanded="false" aria-controls="services-dropdown">
            {t('nav_services')} <i class="fa-solid fa-chevron-down text-xs ml-1 transition-transform duration-300"></i>
          </a>
          <div id="services-dropdown" class="nav-dropdown-content">
            {navServiceLinks.map((s) => (
              <a href={servicePath(s.id, lang)} class="dropdown-item">
                <i class={s.icon}></i>
                <div class="dropdown-text">
                  <span class="dropdown-title">{t(s.labelKey)}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
            <li><a href={getRelativeLocaleUrl(lang, 'project')}>{t("nav_portfolio")}</a></li>
<li><a href={`/${lang}/brief/`}>{t("nav_brief")}</a></li>
<li><a href={`/${lang}/blog/`}>{t("nav_blog")}</a></li>
<li><a href={getRelativeLocaleUrl(lang, lang === 'ru' ? 'uslugi' : 'services') + '#faq'}>{t("nav_faq")}</a></li>
<li><a href={getRelativeLocaleUrl(lang, 'about')}>{t("nav_about")}</a></li>
        </ul>
        <div class="controls">
            <div class="retro-hud-badge" aria-hidden="true">
                <span class="hud-dot"></span>
                <span>{t("retro_hud_p1")}</span>
            </div>
            <button
                type="button"
                class="retro-mode-toggle mode-switcher"
                aria-label={t("aria_mode_switcher")}
                title={t("aria_mode_switcher")}
            >
                <i class="fa-solid fa-gamepad" aria-hidden="true"></i>
                <span class="mode-toggle-label">
                    <span class="label-default">{t("mode_retro_label")}</span>
                    <span class="label-arcade">{lang === 'ru' ? '▶ ЖМИ СТАРТ' : '▶ PRESS START'}</span>
                </span>
            </button>
            <button
                class="control-btn theme-switcher"
                aria-label={t("aria_theme_switcher")}
            >
                <Icon name="fa-sun" aria-hidden="true" />
            </button>
            <LanguageSwitcher translationSlug={translationSlug} />
        </div>
        <!-- Mobile actions: FAB + burger, grouped right on mobile -->
        <div class="mobile-actions">
            <!-- Mobile Retro Toggle: always visible on mobile, hidden on desktop -->
            <button
                type="button"
                class="retro-mode-toggle mode-switcher mobile-retro-fab"
                aria-label={t("aria_mode_switcher")}
                title={t("aria_mode_switcher")}
            >
                <i class="fa-solid fa-gamepad" aria-hidden="true"></i>
                <span class="fab-label">
                    <span class="fab-label-retro">{lang === 'ru' ? 'РЕТРО' : 'RETRO'}</span>
                    <span class="fab-label-exit">{lang === 'ru' ? 'ВЫХОД' : 'EXIT'}</span>
                </span>
            </button>
            <button class="burger-menu" aria-label={t("aria_open_menu")} aria-expanded="false" aria-controls="mobile-nav">
                <div></div>
                <div></div>
                <div></div>
            </button>
        </div>
    </nav>
    <!-- Retro Chiptune Docked Player attached directly to bottom edge of header -->
    <RetroAudioPlayer />
</header>

<!-- Мобильное меню вынесено сюда же для инкапсуляции -->
<div class="mobile-nav-overlay"></div>
<div id="mobile-nav" class="mobile-nav">
    <ul class="mobile-menu-list">
        <li class="mobile-accordion-item">
            <button class="mobile-accordion-trigger" aria-expanded="false">
                <span>{t("nav_services")}</span>
                <i class="fa-solid fa-chevron-down accordion-arrow"></i>
            </button>
            <div class="mobile-accordion-content">
                <div class="mobile-accordion-inner">
                    {navServiceLinks.map((s) => (
                        <a href={servicePath(s.id, lang)} class="mobile-nav-link"><i class={s.icon}></i> {t(s.labelKey)}</a>
                    ))}
                </div>
            </div>
        </li>
        <li><a href={getRelativeLocaleUrl(lang, 'project')}>{t("nav_portfolio")}</a></li>
<li><a href={`/${lang}/brief/`}>{t("nav_brief")}</a></li>
<li><a href={`/${lang}/blog/`}>{t("nav_blog")}</a></li>
<li><a href={getRelativeLocaleUrl(lang, lang === 'ru' ? 'uslugi' : 'services') + '#faq'}>{t("nav_faq")}</a></li>
<li><a href={getRelativeLocaleUrl(lang, 'about')}>{t("nav_about")}</a></li>
    </ul>
    <div class="mobile-controls">
        <div class="mobile-mode-row">
            <button
                type="button"
                class="retro-mode-toggle mode-switcher"
                aria-label={t("aria_mode_switcher")}
                title={t("aria_mode_switcher")}
            >
                <i class="fa-solid fa-gamepad" aria-hidden="true"></i>
                <span class="mode-toggle-label">
                    <span class="label-default">{t("mode_retro_label")}</span>
                    <span class="label-arcade">{lang === 'ru' ? '▶ ЖМИ СТАРТ' : '▶ PRESS START'}</span>
                </span>
            </button>
        </div>
        <div class="mobile-tools-row">
            <button
                class="control-btn theme-switcher"
                aria-label={t("aria_theme_switcher")}
            >
                <i class="fas fa-sun" aria-hidden="true"></i>
            </button>
            <LanguageSwitcher translationSlug={translationSlug} />
        </div>
    </div>
</div>
