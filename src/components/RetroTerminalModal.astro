---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
---

<!-- Retro CRT Developer CLI Terminal Modal -->
<div id="retro-terminal-modal" class="retro-terminal-modal" aria-hidden="true" role="dialog">
    <div class="terminal-cabinet">
        <!-- Top Titlebar -->
        <div class="terminal-titlebar">
            <div class="terminal-title-left">
                <span class="terminal-dot red"></span>
                <span class="terminal-dot yellow"></span>
                <span class="terminal-dot green"></span>
                <span class="terminal-system-name">AVP-OS v1.984 [TTY-1]</span>
            </div>
            <div class="terminal-title-right">
                <span class="terminal-hint">KEY: [ ~ ] • TAB: AUTO-COMPLETE • [ ↑/↓ ]: HISTORY</span>
                <button type="button" id="terminal-close-btn" class="terminal-btn close" title="Close Terminal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>

        <!-- Terminal CRT Viewport -->
        <div class="terminal-viewport">
            <div class="terminal-crt-scanlines"></div>
            <div class="terminal-crt-glow"></div>
            <div id="terminal-output" class="terminal-output">
                <div class="t-line t-banner">
                    ========================================================<br />
                    * * *  AVP-DEV CYBERNETIC TERMINAL v1.984  * * *<br />
                    (C) 1984-2026 AVP-DEV DIGITAL SYSTEMS CORP.<br />
                    STATUS: ONLINE // MEMORY: 640KB // AUTH: GUEST-DEV<br />
                    ========================================================<br />
                    <span class="hl-head">COMMAND QUICK LAUNCH (type or click):</span><br />
                    • <span class="hl t-cmd-chip" data-cmd="play">play</span>         - 🕹️ Launch Retro Arcade (Defender & Bricks)<br />
                    • <span class="hl t-cmd-chip" data-cmd="achievements">achievements</span> - 🏆 Trophy Room & Unlocked Badges<br />
                    • <span class="hl t-cmd-chip" data-cmd="hire">hire</span>         - 💬 Telegram Uplink to @AVP_Dev<br />
                    • <span class="hl t-cmd-chip" data-cmd="skills">skills</span>       - ⚡ Tech Stack & Architecture Meters<br />
                    • <span class="hl t-cmd-chip" data-cmd="projects">projects</span>     - 🚀 Client Case Studies & Production<br />
                    • <span class="hl t-cmd-chip" data-cmd="calc">calc</span>         - 🧮 Project Price Estimator Matrix<br />
                    • <span class="hl t-cmd-chip" data-cmd="cv">cv</span>           - 👤 Engineer Résumé & Dossier<br />
                    • <span class="hl t-cmd-chip" data-cmd="music">music</span>        - 🎵 Next 8-Bit Chiptune Track<br />
                    • <span class="hl t-cmd-chip" data-cmd="matrix">matrix</span>       - 🟢 Green Digital Rain Animation<br />
                    • <span class="hl t-cmd-chip" data-cmd="godmode">godmode</span>      - ⭐ Konami Cheat Fireworks<br />
                    • <span class="hl t-cmd-chip" data-cmd="clear">clear</span>        - 🧹 Clear Screen  •  <span class="hl t-cmd-chip" data-cmd="exit">exit</span> - ❌ Close Window<br />
                    ========================================================
                </div>
            </div>

            <!-- Terminal Command Input Row -->
            <form id="terminal-form" class="terminal-input-row" autocomplete="off">
                <span class="terminal-prompt">avp-dev:~$</span>
                <input 
                    type="text" 
                    id="terminal-input" 
                    class="terminal-input" 
                    autocapitalize="off" 
                    autocorrect="off" 
                    spellcheck="false" 
                    placeholder="type a command (try 'help' or press Tab)..." 
                />
                <span class="terminal-cursor">█</span>
            </form>
        </div>
    </div>
</div>

<script>
    import { retroAudio } from '../scripts/retroAudio';
    import { retroAchievements, ACHIEVEMENTS } from '../scripts/retroAchievements';

    let isTerminalOpen = false;
    let matrixInterval: any = null;
    const cmdHistory: string[] = [];
    let historyIndex = -1;

    const ALL_COMMAND_NAMES = [
        'help', 'about', 'skills', 'projects', 'contact', 'play', 'hire', 
        'quote', 'matrix', 'godmode', 'music', 'theme', 'clear', 'cls', 
        'exit', 'quit', 'coffee', 'doom', 'sudo', 'turbo', 'overclock', 
        'dance', 'barrelroll', 'flip', 'achievements', 'trophies', 
        'calc', 'cv', 'resume', 'ping'
    ];

    const CYBER_QUOTES = [
        "«I've seen things you people wouldn't believe. Attack ships on fire off the shoulder of Orion.» — Roy Batty (Blade Runner)",
        "«The Matrix is everywhere. It is all around us. Even now, in this very room.» — Morpheus",
        "«There is no spoon.» — The Matrix",
        "«The sky above the port was the color of television, tuned to a dead channel.» — William Gibson (Neuromancer)",
        "«Greetings, programs!» — Flynn (TRON)"
    ];

    const COMMANDS: Record<string, string> = {
        'help': `
<span class="hl-head">AVAILABLE COMMANDS:</span>
  <span class="hl">achievements</span> - View unlocked trophy room & badges
  <span class="hl">about</span>        - Company mission & developer dossier
  <span class="hl">skills</span>       - Interactive technology ASCII meters
  <span class="hl">projects</span>     - Featured client case studies
  <span class="hl">calc</span>         - Project investment & scope calculator
  <span class="hl">cv</span> / <span class="hl">resume</span>  - Engineer quick résumé dossier
  <span class="hl">ping</span>         - Network latency benchmark
  <span class="hl">play</span>         - Launch Retro Arcade console (Space Defender / Bricks)
  <span class="hl">hire</span>         - Instant Telegram uplink to discuss project with AVP-Dev
  <span class="hl">quote</span>        - Cyberpunk & Sci-Fi quote generator
  <span class="hl">matrix</span>       - Stream falling green digital Matrix rain
  <span class="hl">godmode</span>      - Trigger Konami code celebration
  <span class="hl">music</span>        - Next 8-bit chiptune background track
  <span class="hl">theme</span>        - Switch theme mode (retro / dark / light)
  <span class="hl">contact</span>      - Telegram, Email & contact coordinates
  <span class="hl">clear</span>        - Clear terminal screen
  <span class="hl">exit</span>         - Close terminal window
        `,
        'about': `
<span class="hl-head">AVP-DEV STUDIO DOSSIER:</span>
  Full-cycle web & mobile engineering studio.
  Specializing in ultra-fast Astro/React web applications,
  scalable SaaS platforms, Telegram Mini Apps & AI pipelines.
  Performance benchmark: <span class="hl">100/100 Lighthouse</span>.
  Engineering tenure: <span class="hl">19+ Years</span>.
        `,
        'skills': `
<span class="hl-head">TECH CAPABILITIES:</span>
  ASTRO / REACT / NEXT.JS [████████████████████] 100%
  TYPESCRIPT / JAVASCRIPT [████████████████████] 100%
  WEB AUDIO & CANVAS 2D   [██████████████████░░] 94%
  AI & LLM ORCHESTRATION  [██████████████████░░] 92%
  NODE.JS / POSTGRESQL    [██████████████████░░] 90%
  DOCKER & CLOUD DEVOPS   [████████████████░░░░] 88%
        `,
        'projects': `
<span class="hl-head">FEATURED CASE STUDIES:</span>
  1. Storno Logistics - High-load ERP & routing platform
  2. Hot-Tours Travel - Fast booking & tour aggregation
  3. PWA Web App Suite - Native offline mobile web experience
  (Type '<span class="hl">play</span>' to test arcade or visit /project/ page)
        `,
        'contact': `
<span class="hl-head">COMMUNICATION CHANNELS:</span>
  Telegram: <a href="https://t.me/AVP_Dev" target="_blank" class="t-link">@AVP_Dev</a>
  Email:    <a href="mailto:hello@avpdev.com" class="t-link">hello@avpdev.com</a>
  WhatsApp: <a href="https://wa.me/375291217371" target="_blank" class="t-link">+375 29 121-73-71</a>
  Brief:    <a href="/ru/brief/" class="t-link">/brief/ (Online Project Estimator)</a>
        `,
        'calc': `
<span class="hl-head">⚡ PROJECT SCOPE ESTIMATOR MATRIX ⚡</span>
  [1] High-Conversion Landing Page / Promo:  1-2 Weeks   | ★★★☆☆
  [2] Telegram Mini App (TMA / WebApp):     2-3 Weeks   | ★★★★☆
  [3] E-Commerce / Online Store:            3-4 Weeks   | ★★★★☆
  [4] Full SaaS Platform / AI Automations:  4-8 Weeks   | ★★★★★
  (Type '<span class="hl">hire</span>' or visit <span class="hl">/brief/</span> to calculate exact specifications)
        `,
        'cv': `
<span class="hl-head">👤 INGENIEUR DOSSIER // AVP-DEV:</span>
  Role: Founder & Full-Stack Lead Engineer
  Exp: 19+ Years (Web Architecture, High-Load, AI Systems)
  Methodology: Clean Architecture, Zero-Bloat, 100/100 CWV
  Uplink: <a href="https://t.me/AVP_Dev" target="_blank" class="t-link">@AVP_Dev</a>
        `,
        'coffee': `
<span class="hl">HTTP 418: I'M A TEAPOT ☕</span>
  [||||||||||||||||||||] 100% Brewed
  Origin: High-Altitude Artisan Arabica
  Purpose: Fuel for late-night bug-free deployments & zero-latency code.
        `,
        'doom': `
<span class="hl-head">💀 DOOM 1993 PROTOCOL:</span>
   [======]
  /  ..  \\  IDKFA: ALL WEAPONS & KEYS LOADED!
 |   ==   | IDDQD: DEGREELESSNESS MODE ENGAGED.
  \\______/  RIP AND TEAR UNTIL IT IS DONE.
        `,
        'sudo': `<span class="t-err">ACCESS DENIED: AVP-DEV IS SUPERUSER. NICE TRY, MR. FALKEN.</span>`
    };

    function printToTerminal(html: string) {
        const out = document.getElementById('terminal-output');
        if (!out) return;
        const line = document.createElement('div');
        line.className = 't-line';
        line.innerHTML = html;
        out.appendChild(line);
        out.scrollTop = out.scrollHeight;
    }

    function renderAchievementsTable() {
        const list = Object.values(ACHIEVEMENTS);
        const unlockedCount = retroAchievements.getUnlockedCount();
        const total = retroAchievements.getTotalCount();
        const isRu = document.documentElement.lang === 'ru';

        let html = `<span class="hl-head">🏆 RETRO TROPHY ROOM [${unlockedCount}/${total} UNLOCKED]:</span><br />`;
        list.forEach(a => {
            const isDone = retroAchievements.isUnlocked(a.id);
            const title = isRu ? a.titleRu : a.titleEn;
            const desc = isRu ? a.descRu : a.descEn;
            const status = isDone ? `<span class="hl">★ UNLOCKED</span>` : `<span style="color:#778899;">[ LOCKED ]</span>`;
            html += `• ${a.icon} <b>${title}</b>: ${status} — <span style="color:#8ba3c7;">${desc}</span><br />`;
        });
        printToTerminal(html);
    }

    function executeCommand(rawCmd: string) {
        const cmd = rawCmd.trim().toLowerCase();
        if (!cmd) return;

        printToTerminal(`<span class="t-user-cmd">avp-dev:~$ ${rawCmd}</span>`);
        retroAudio.playLaserShoot();

        // Track command count for achievements
        retroAchievements.trackCommandExecuted();

        if (matrixInterval) {
            clearInterval(matrixInterval);
            matrixInterval = null;
        }

        if (cmd === 'clear' || cmd === 'cls') {
            const out = document.getElementById('terminal-output');
            if (out) out.innerHTML = '';
            return;
        }

        if (cmd === 'exit' || cmd === 'quit') {
            closeTerminal();
            return;
        }

        if (cmd === 'achievements' || cmd === 'trophies' || cmd === 'awards') {
            renderAchievementsTable();
            return;
        }

        if (cmd === 'ping') {
            const start = performance.now();
            printToTerminal('<span class="hl">PING avpdev.com (127.0.0.1): 56 data bytes</span>');
            setTimeout(() => {
                const latency = Math.max(8, Math.round(performance.now() - start));
                printToTerminal(`<span class="hl-head">64 bytes from avpdev.com: icmp_seq=1 ttl=64 time=${latency} ms [SPEED: LIGHTSPEED]</span>`);
            }, 120);
            return;
        }

        if (cmd === 'coffee') {
            retroAchievements.unlock('caffeine');
            printToTerminal(COMMANDS['coffee']);
            retroAudio.play1Up();
            return;
        }

        if (cmd === 'quote' || cmd === 'quotes') {
            const q = CYBER_QUOTES[Math.floor(Math.random() * CYBER_QUOTES.length)];
            printToTerminal(`<span class="hl-head">${q}</span>`);
            return;
        }

        if (cmd === 'hire' || cmd === 'order' || cmd === 'telegram') {
            printToTerminal('<span class="hl">TRANSMITTING UPLINK TO TELEGRAM @AVP_Dev...</span>');
            window.open('https://t.me/AVP_Dev', '_blank');
            return;
        }

        if (cmd === 'godmode' || cmd === 'konami') {
            printToTerminal('<span class="hl-head">⚡ OVERRIDE: GOD MODE ENGAGED! ⚡</span>');
            closeTerminal();
            const cheatChip = document.querySelector('.retro-hero-chip.secret-hint') as HTMLElement | null;
            if (cheatChip) {
                cheatChip.click();
            } else {
                retroAchievements.unlock('god_mode');
            }
            return;
        }

        if (cmd === 'idkfa' || cmd === 'iddqd' || cmd === 'doom') {
            printToTerminal(COMMANDS['doom']);
            retroAudio.playCarBoost();
            return;
        }

        if (cmd === 'dance') {
            printToTerminal('<span class="hl-head">♪┏(・o･)┛♪ ┗( ･o･)┓♪ ┏(･o･)┛♪ DANCE PARTY!</span>');
            retroAudio.play1Up();
            return;
        }

        if (cmd === 'flip' || cmd === 'barrelroll') {
            printToTerminal('<span class="hl">🌀 PERFORMING BARREL ROLL...</span>');
            document.body.style.transition = 'transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)';
            document.body.style.transform = 'rotate(360deg)';
            setTimeout(() => {
                document.body.style.transform = '';
                setTimeout(() => { document.body.style.transition = ''; }, 1200);
            }, 1200);
            return;
        }

        if (cmd === 'turbo' || cmd === 'overclock') {
            printToTerminal('<span class="hl-head">⚡ 200% OVERCLOCK MODE ENGAGED! ⚡</span>');
            document.body.classList.add('overclock-active');
            retroAudio.playCarBoost();
            setTimeout(() => document.body.classList.remove('overclock-active'), 10000);
            return;
        }

        if (cmd === 'play' || cmd === 'game' || cmd === 'arcade') {
            printToTerminal('<span class="hl">LAUNCHING ARCADE SYSTEM...</span>');
            closeTerminal();
            document.dispatchEvent(new CustomEvent('open-retro-arcade'));
            return;
        }

        if (cmd === 'music' || cmd === 'track') {
            retroAudio.nextTrack();
            const state = retroAudio.getState();
            printToTerminal(`<span class="hl">NOW PLAYING: ${state.currentTrack.title}</span>`);
            return;
        }

        if (cmd === 'theme') {
            const isRetro = document.documentElement.classList.contains('retro-mode');
            const targetRetro = !isRetro;
            document.dispatchEvent(new CustomEvent('theme:mode-changed', { detail: { isRetro: targetRetro } }));
            printToTerminal(`<span class="hl">THEME SWITCHED TO: ${targetRetro ? 'RETRO' : 'MODERN'}</span>`);
            return;
        }

        if (cmd === 'resume') {
            printToTerminal(COMMANDS['cv']);
            return;
        }

        if (cmd === 'matrix') {
            printToTerminal('<span class="hl-head">CONNECTING TO THE MATRIX (Press any key to stop)...</span>');
            const chars = '0123456789ABCDEF$#@%&*+=~';
            matrixInterval = setInterval(() => {
                let str = '';
                for (let i = 0; i < 48; i++) {
                    str += chars[Math.floor(Math.random() * chars.length)] + ' ';
                }
                printToTerminal(`<span class="t-matrix">${str}</span>`);
            }, 60);
            return;
        }

        if (COMMANDS[cmd]) {
            printToTerminal(COMMANDS[cmd]);
        } else {
            printToTerminal(`<span class="t-err">Command not found: '${rawCmd}'. Type '<span class="hl">help</span>' for manual.</span>`);
        }
    }

    function openTerminal() {
        const modal = document.getElementById('retro-terminal-modal');
        const input = document.getElementById('terminal-input') as HTMLInputElement | null;
        if (!modal) return;

        isTerminalOpen = true;
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        retroAudio.playWarp();
        if (input) {
            setTimeout(() => input.focus(), 150);
        }
    }

    function closeTerminal() {
        const modal = document.getElementById('retro-terminal-modal');
        if (!modal) return;

        isTerminalOpen = false;
        modal.classList.remove('open');
        modal.setAttribute('aria-hidden', 'true');
        if (matrixInterval) {
            clearInterval(matrixInterval);
            matrixInterval = null;
        }
    }

    // Key listeners: Tilde / Grave (~) or global delegated button
    if (!(window as any).__terminalDelegationReady) {
        (window as any).__terminalDelegationReady = true;

        document.addEventListener('keydown', (e) => {
            // Tilde ~ or Backquote ` across any layout (EN, RU, Mac, PC)
            const isTilde = e.code === 'Backquote' || 
                            e.keyCode === 192 || 
                            (e as any).which === 192 || 
                            e.key === '`' || 
                            e.key === '~' || 
                            e.key === 'ё' || 
                            e.key === 'Ё' || 
                            e.key === '§' || 
                            e.key === 'Dead';

            if (isTilde) {
                const active = document.activeElement;
                if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA') && active.id !== 'terminal-input') {
                    return;
                }
                e.preventDefault();
                if (isTerminalOpen) {
                    closeTerminal();
                } else {
                    openTerminal();
                }
            } else if (e.key === 'Escape' && isTerminalOpen) {
                closeTerminal();
            }
        });

        document.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            if (!target) return;

            if (target.closest('[data-open-terminal]')) {
                e.preventDefault();
                openTerminal();
                return;
            }

            if (target.closest('#terminal-close-btn')) {
                e.preventDefault();
                closeTerminal();
                return;
            }

            const chip = target.closest('.t-cmd-chip') as HTMLElement | null;
            if (chip && chip.dataset.cmd) {
                e.preventDefault();
                executeCommand(chip.dataset.cmd);
                return;
            }
        });

        document.addEventListener('open-retro-terminal', () => {
            openTerminal();
        });

        const form = document.getElementById('terminal-form') as HTMLFormElement | null;
        const input = document.getElementById('terminal-input') as HTMLInputElement | null;
        
        if (form && input) {
            // Tab Auto-Complete and Up/Down Command History
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Tab') {
                    e.preventDefault();
                    const current = input.value.trim().toLowerCase();
                    if (!current) return;

                    const match = ALL_COMMAND_NAMES.find(c => c.startsWith(current));
                    if (match) {
                        input.value = match;
                        retroAudio.playClick();
                    }
                    return;
                }

                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (cmdHistory.length === 0) return;
                    if (historyIndex === -1) {
                        historyIndex = cmdHistory.length - 1;
                    } else if (historyIndex > 0) {
                        historyIndex--;
                    }
                    input.value = cmdHistory[historyIndex] || '';
                    return;
                }

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (cmdHistory.length === 0 || historyIndex === -1) return;
                    if (historyIndex < cmdHistory.length - 1) {
                        historyIndex++;
                        input.value = cmdHistory[historyIndex] || '';
                    } else {
                        historyIndex = -1;
                        input.value = '';
                    }
                    return;
                }
            });

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                const val = input.value;
                if (val.trim()) {
                    cmdHistory.push(val.trim());
                    historyIndex = -1;
                }
                input.value = '';
                executeCommand(val);
            });
        }
    }
</script>
