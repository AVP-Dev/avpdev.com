<script is:inline>
  (function () {
    var BOT_ID = "6189cc04-81ac-4023-9522-3a190f8849bd";
    var initCount = 0;
    var loaded = false;

    function cleanup() {
      document.querySelectorAll("[id^='pw-']").forEach(function (el) { el.remove(); });
      document.querySelectorAll("style").forEach(function (s) {
        if (s.textContent && s.textContent.indexOf("pw-btn") !== -1) s.remove();
      });
      window.ParalectWidget = undefined;
    }

    function inject() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement("script");
      s.src = "https://ParalectAI.avpdev.com/loader.js";
      s.async = true;
      s.setAttribute("data-bot-id", BOT_ID);
      document.body.appendChild(s);
    }

    function tryLoad() {
      if (!loaded) inject();
    }

    document.addEventListener("astro:page-load", function () {
      initCount++;
      if (initCount === 1) {
        document.addEventListener("scroll", tryLoad, { once: true });
        document.addEventListener("mousemove", tryLoad, { once: true });
        document.addEventListener("touchstart", tryLoad, { once: true });
        document.addEventListener("click", tryLoad, { once: true });
        window.addEventListener("load", function () {
          setTimeout(tryLoad, 3000);
        });
      } else {
        cleanup();
        loaded = false;
        inject();
      }
    });
  })();
</script>
