---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import AccordionItem from '../AccordionItem.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pairs = [
    ['faq_q1', 'faq_a1'],
    ['faq_q2', 'faq_a2'],
    ['faq_q3', 'faq_a3'],
    ['faq_q4', 'faq_a4'],
    ['faq_q5', 'faq_a5'],
] as const;
---
<section id="faq" class="faq-section">
    <div class="container container-narrow">
        <h2 class="section-title fade-in" set:html={t('faq_h2')} />
        <div class="acc-list fade-in" data-accordion>
            {pairs.map(([q, a]) => (
                <AccordionItem q={t(q)} a={t(a)} />
            ))}
        </div>
    </div>
</section>

<style>
    .faq-section {
        padding: 80px 0;
        border-top: 1px solid var(--border-color);
    }
    .container-narrow {
        max-width: 800px;
        margin: 0 auto;
    }
</style>
