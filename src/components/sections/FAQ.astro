---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="faq" class="faq-section">
    <div class="container container-narrow">
        <h2 class="section-title fade-in" set:html={t('faq_h2')} />
        <div class="faq-list fade-in">
            <details class="faq-card">
                <summary class="faq-question">
                    <span class="faq-question-text">{t('faq_q1')}</span>
                    <span class="faq-icon-wrapper">
                        <Icon name="fa-plus" aria-hidden="true" />
                    </span>
                </summary>
                <div class="faq-answer-wrapper">
                    <p class="faq-answer">{t('faq_a1')}</p>
                </div>
            </details>
            <details class="faq-card">
                <summary class="faq-question">
                    <span class="faq-question-text">{t('faq_q2')}</span>
                    <span class="faq-icon-wrapper">
                        <Icon name="fa-plus" aria-hidden="true" />
                    </span>
                </summary>
                <div class="faq-answer-wrapper">
                    <p class="faq-answer">{t('faq_a2')}</p>
                </div>
            </details>
            <details class="faq-card">
                <summary class="faq-question">
                    <span class="faq-question-text">{t('faq_q3')}</span>
                    <span class="faq-icon-wrapper">
                        <Icon name="fa-plus" aria-hidden="true" />
                    </span>
                </summary>
                <div class="faq-answer-wrapper">
                    <p class="faq-answer">{t('faq_a3')}</p>
                </div>
            </details>
            <details class="faq-card">
                <summary class="faq-question">
                    <span class="faq-question-text">{t('faq_q4')}</span>
                    <span class="faq-icon-wrapper">
                        <Icon name="fa-plus" aria-hidden="true" />
                    </span>
                </summary>
                <div class="faq-answer-wrapper">
                    <p class="faq-answer">{t('faq_a4')}</p>
                </div>
            </details>
            <details class="faq-card">
                <summary class="faq-question">
                    <span class="faq-question-text">{t('faq_q5')}</span>
                    <span class="faq-icon-wrapper">
                        <Icon name="fa-plus" aria-hidden="true" />
                    </span>
                </summary>
                <div class="faq-answer-wrapper">
                    <p class="faq-answer">{t('faq_a5')}</p>
                </div>
            </details>
        </div>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', () => {
        const cards = document.querySelectorAll('.faq-card');

        cards.forEach(card => {
            const summary = card.querySelector('.faq-question');

            summary.addEventListener('click', (e) => {
                if (!card.open) {
                    cards.forEach(other => {
                        if (other !== card) {
                            other.removeAttribute('open');
                        }
                    });
                }
            });
        });
    });
</script>

<style>
    .faq-section {
        padding: 80px 0;
        border-top: 1px solid var(--border-color);
    }
    .container-narrow {
        max-width: 800px;
        margin: 0 auto;
    }
    .faq-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 3rem;
    }
    .faq-card {
        background: var(--primary-color);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        box-shadow: var(--card-shadow);
        padding: 0;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                    box-shadow 0.4s ease,
                    border-color 0.3s ease;
        overflow: hidden;
    }
    .faq-card:hover {
        border-color: rgba(var(--accent-color-start-rgb), 0.35);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }
    details[open].faq-card {
        border-color: rgba(var(--accent-color-start-rgb), 0.5);
        box-shadow: 0 8px 32px rgba(var(--accent-color-start-rgb), 0.12),
                    0 20px 40px rgba(0, 0, 0, 0.35);
    }
    .faq-question {
        padding: 1.5rem 1.75rem;
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--text-color);
        font-family: var(--font-body);
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        user-select: none;
        list-style: none;
        transition: background 0.3s ease;
    }
    .faq-question::-webkit-details-marker {
        display: none;
    }
    .faq-question::after {
        content: none;
    }
    .faq-question:hover {
        background: rgba(var(--accent-color-start-rgb), 0.04);
    }
    details[open] .faq-question {
        background: rgba(var(--accent-color-start-rgb), 0.05);
        color: var(--accent-color-start);
    }
    .faq-question-text {
        flex: 1;
        padding-right: 1rem;
    }
    .faq-icon-wrapper {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(var(--accent-color-start-rgb), 0.1), rgba(var(--accent-color-end-rgb), 0.05));
        border: 1px solid rgba(var(--accent-color-start-rgb), 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-color-start);
        font-size: 1rem;
        flex-shrink: 0;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
                    background 0.3s ease,
                    border-color 0.3s ease,
                    color 0.3s ease;
    }
    details[open] .faq-icon-wrapper {
        transform: rotate(45deg);
        background: linear-gradient(135deg, rgba(var(--accent-color-start-rgb), 0.25), rgba(var(--accent-color-end-rgb), 0.12));
        border-color: rgba(var(--accent-color-start-rgb), 0.5);
        color: var(--accent-color-start);
    }
    .faq-answer-wrapper {
        overflow: hidden;
    }
    .faq-answer {
        font-size: 1rem;
        color: var(--text-secondary-color);
        line-height: 1.65;
        padding: 0 1.75rem 1.75rem;
        margin: 0;
        animation: faqFadeIn 0.35s ease-out;
        font-family: var(--font-body);
        font-weight: 400;
    }
    @keyframes faqFadeIn {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @media (max-width: 640px) {
        .faq-question {
            padding: 1.25rem 1.25rem;
            font-size: 1rem;
        }
        .faq-answer {
            padding: 0 1.25rem 1.25rem;
            font-size: 0.95rem;
        }
    }
</style>
