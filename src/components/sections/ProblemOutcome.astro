---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="problem-outcome" class="section">
    <div class="container">
        <h2 class="section-title fade-in" set:html={t('problem_h2')} />
        <div class="po-grid fade-in">
            <div class="po-column problem-column">
                <div class="column-badge problem-badge">{lang === 'ru' ? 'Проблема' : 'Problem'}</div>
                <ul class="po-list">
                    <li class="po-item problem-item"><span class="bullet bullet-problem"></span>{t('problem_item1')}</li>
                    <li class="po-item problem-item"><span class="bullet bullet-problem"></span>{t('problem_item2')}</li>
                    <li class="po-item problem-item"><span class="bullet bullet-problem"></span>{t('problem_item3')}</li>
                    <li class="po-item problem-item"><span class="bullet bullet-problem"></span>{t('problem_item4')}</li>
                </ul>
            </div>
            <div class="arrow-col">
                <span class="arrow-icon">&rarr;</span>
            </div>
            <div class="outcome-col">
                <div class="column-badge outcome-badge">{lang === 'ru' ? 'Решение' : 'Solution'}</div>
                <ul class="po-list">
                    <li class="po-item outcome-item"><span class="bullet bullet-outcome"></span>{t('outcome_item1')}</li>
                    <li class="po-item outcome-item"><span class="bullet bullet-outcome"></span>{t('outcome_item2')}</li>
                    <li class="po-item outcome-item"><span class="bullet bullet-outcome"></span>{t('outcome_item3')}</li>
                    <li class="po-item outcome-item"><span class="bullet bullet-outcome"></span>{t('outcome_item4')}</li>
                </ul>
            </div>
        </div>
        <div class="po-cta fade-in">
            <a href={`/${lang}/#contact`} class="cta-button">{t('outcome_cta')}</a>
        </div>
    </div>
</section>

<style>
    .section { padding: 80px 0; }
    .po-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 2rem;
        align-items: start;
        margin-top: 3rem;
        max-width: 1100px;
        margin-left: auto;
        margin-right: auto;
    }
    .problem-column, .outcome-col {
        background: var(--primary-color);
        padding: 2.5rem 2rem;
        border-radius: 24px;
        border: 1px solid var(--glass-border);
        box-shadow: var(--card-shadow);
    }
    .column-badge {
        display: inline-flex;
        padding: 0.35rem 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border-radius: 9999px;
        margin-bottom: 1.5rem;
    }
    .problem-badge {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.25);
    }
    .outcome-badge {
        background: rgba(var(--accent-color-start-rgb), 0.15);
        color: var(--accent-color-start);
        border: 1px solid rgba(var(--accent-color-start-rgb), 0.25);
    }
    :global(.light-theme) .outcome-badge {
        color: var(--accent-color);
    }
    .po-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
    }
    .po-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        font-size: 1rem;
        color: var(--text-secondary-color);
        line-height: 1.5;
    }
    .problem-item { color: rgba(239, 68, 68, 0.9); }
    .outcome-item { color: var(--text-color); }
    .bullet {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 0.45rem;
    }
    .bullet-problem { background: #ef4444; }
    .bullet-outcome { background: var(--accent-color-start); }
    .arrow-col {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 3rem;
    }
    .arrow-icon {
        font-size: 2rem;
        color: var(--accent-color-start);
        font-weight: 700;
    }
    .po-cta {
        text-align: center;
        margin-top: 3rem;
    }
    @media (max-width: 768px) {
        .po-grid {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
        .arrow-col {
            display: none;
        }
    }
</style>