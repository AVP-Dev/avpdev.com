---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="proof" class="proof-section">
    <div class="container">
        <div class="proof-bar fade-in">
            <div class="proof-item">
                <Icon name="fa-clock" class="proof-icon" aria-hidden="true" />
                <span class="proof-stat proof-stat-default">{t('proof_stat1')}</span>
                <span class="proof-stat proof-stat-retro">{lang === 'ru' ? '[ УРОВЕНЬ 19: АРХИТЕКТОР // 19+ ЛЕТ ОПЫТА ]' : '[ LVL 19 ARCHITECT // 19+ YRS EXP ]'}</span>
            </div>
            <div class="proof-divider"></div>
            <div class="proof-item">
                <Icon name="fa-globe" class="proof-icon" aria-hidden="true" />
                <span class="proof-stat proof-stat-default">{t('proof_stat2')}</span>
                <span class="proof-stat proof-stat-retro">{lang === 'ru' ? '[ 5 МИРОВ // СЕТЬ КЛИЕНТОВ ]' : '[ 5 GLOBAL REALMS // CLIENTS NETWORK ]'}</span>
            </div>
            <div class="proof-divider"></div>
            <div class="proof-item">
                <Icon name="fa-code-branch" class="proof-icon" aria-hidden="true" />
                <span class="proof-stat proof-stat-default">{t('proof_stat3')}</span>
                <span class="proof-stat proof-stat-retro">{lang === 'ru' ? '[ OPEN SOURCE // ВКЛАД В ОТКРЫТЫЙ КОД ]' : '[ OPEN SOURCE // CORE CONTRIBUTOR ]'}</span>
            </div>
        </div>
    </div>
</section>

<style>
    .proof-section {
        padding: 3rem 0;
        border-bottom: 1px solid var(--border-color);
        background: var(--primary-color);
    }
    .proof-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 3rem;
        flex-wrap: wrap;
    }
    .proof-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-align: center;
    }
    .proof-icon {
        font-size: 1.5rem;
        color: var(--accent-color-start);
        margin-bottom: 0.25rem;
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(var(--accent-color-start-rgb), 0.1), rgba(var(--accent-color-end-rgb), 0.05));
        border: 1px solid rgba(var(--accent-color-start-rgb), 0.2);
    }
    .proof-stat {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-color);
        line-height: 1.35;
        overflow-wrap: break-word;
        word-break: normal;
        hyphens: none;
    }
    .proof-divider {
        width: 1px;
        height: 60px;
        background: var(--border-color);
    }
    @media (max-width: 640px) {
        .proof-bar {
            gap: 1.5rem 1rem;
        }
        .proof-divider {
            display: none;
        }
        .proof-item {
            flex: 1 1 100%;
            min-width: 0;
            max-width: 100%;
        }
    }
</style>