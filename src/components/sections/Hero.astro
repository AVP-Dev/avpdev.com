---
// src/components/sections/Hero.astro
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export interface Props {
  title?: string;
  subtitle?: string;
  variant?: "home" | "services";
}

const { title, subtitle, variant = "home" } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class={`hero-section ${variant}`}>
    <div id="particles-js"></div>
    <div class="retro-synthwave-grid" aria-hidden="true">
        <div class="retro-grid-plane"></div>
    </div>

    {variant === "services" && (
      <div class="services-hero-bg">
        <div class="grid-pattern"></div>
        <div class="glow-blob top"></div>
        <div class="glow-blob bottom"></div>
      </div>
    )}

    <div class="container hero-container">
        <div class="hero-content">
            <div class={`hero-text fade-in ${variant === 'services' ? 'services-text' : ''}`}>
                <div class="retro-hero-hud" aria-hidden="true">
                    <span class="retro-hero-chip p1">{t("retro_hud_p1")}</span>
                    <span class="retro-hero-chip mode">{t("retro_hud_sys")}</span>
                    <span class="retro-hero-chip credits">{t("retro_hud_credits")}</span>
                </div>

                {title ? (
                  <h1 set:html={title}></h1>
                ) : (
                  <h1 set:html={t("hero_h1")} />
                )}
                
                <p>{subtitle || t("hero_subtitle")}</p>
                
                <div class="cta-group">
                    <a href={`/${lang}/#contact`} class="cta-button">
                        {t("hero_cta")}
                    </a>
                    <a href="https://t.me/AVP_Dev" target="_blank" rel="noopener" class="cta-button secondary">
                        {t("hero_cta_secondary")}
                        <i class="fa-brands fa-telegram" style="margin-left: 0.5rem;"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .hero-section {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        /* Safe area aware padding top: 80px (header) + fluid top spacing */
        padding-top: clamp(100px, 15vh, 180px);
        padding-bottom: clamp(60px, 8vh, 100px);
        position: relative;
        overflow: hidden;
        /* Главный заголовок раздела всегда по центру */
        text-align: center;
    }

    .hero-section.services {
        min-height: auto;
        padding-top: clamp(140px, 20vh, 220px);
        padding-bottom: clamp(80px, 12vh, 120px);
        background: var(--bg-color);
        border-bottom: 1px solid var(--border-color);
        text-align: center;
    }

    /* Particles canvas: absolute fill under hero content */
    #particles-js {
        position: absolute;
        inset: 0;
        z-index: 0;
    }

    .hero-section.services .hero-container {
        position: relative;
        z-index: 2;
    }

    .services-hero-bg {
        position: absolute;
        inset: 0;
        overflow: hidden;
        z-index: 0;
    }

    .grid-pattern {
        position: absolute;
        inset: 0;
        background-image: 
            linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 40px 40px;
        mask-image: radial-gradient(ellipse at center, black, transparent 80%);
        -webkit-mask-image: radial-gradient(ellipse at center, black, transparent 80%);
        opacity: 0.5;
    }

    .glow-blob {
        position: absolute;
        width: 60vw;
        height: 60vw;
        max-width: 600px;
        max-height: 600px;
        background: radial-gradient(circle, rgba(var(--accent-color-start-rgb), 0.12) 0%, rgba(var(--accent-color-end-rgb), 0) 70%);
        filter: blur(80px);
        z-index: 0;
        opacity: 0.6;
    }

    .glow-blob.top {
        top: -10%;
        left: 50%;
        transform: translate(-50%, -20%);
    }

    .glow-blob.bottom {
        bottom: -20%;
        right: 10%;
        background: radial-gradient(circle, rgba(var(--accent-color-end-rgb), 0.08) 0%, rgba(var(--accent-color-start-rgb), 0) 70%);
    }

    .hero-container {
        width: 100%;
        position: relative;
        z-index: 2;
    }

    .hero-text h1 {
        font-size: clamp(2.5rem, 8vw, 4.5rem);
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }

    .hero-section.services .hero-text h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        line-height: 1;
        letter-spacing: -0.03em;
        margin-bottom: 24px;
        font-weight: 900;
        background: linear-gradient(to bottom, #fff 30%, rgba(255, 255, 255, 0.7) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        max-width: 900px;
        margin-left: auto;
        margin-right: auto;
    }

    :global(.light-theme) .hero-section.services .hero-text h1 {
        background: linear-gradient(to bottom, var(--text-color) 40%, #555 100%);
        -webkit-background-clip: text;
    }

    /* Двухцветные заголовки на страницах услуг: часть текста с акцентным градиентом */
    .hero-section.services .hero-text h1 :global(.gradient-text) {
        background: var(--accent-gradient);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-text p {
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        margin-bottom: 2.5rem;
        max-width: 700px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero-section.services .hero-text p {
        font-size: clamp(1.1rem, 1.8vw, 1.25rem);
        color: var(--text-secondary-color);
        margin-bottom: 2.5rem;
        max-width: 800px;
        line-height: 1.6;
    }

    :global(.dark-theme) .hero-section.services .hero-text p {
        color: #B4B4B4; /* Lighter than standard secondary for better contrast against blobs */
    }

    .cta-group {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    @media (max-width: 768px) {
        .hero-section {
            padding-top: clamp(120px, 20vh, 160px);
        }
        .hero-section.services {
            padding-top: 140px;
            padding-bottom: 60px;
        }
    }
</style>

<!-- Фоновые частицы: общая инициализация -->
<script is:inline src="https://cdn.jsdelivr.net/particles.js/2.0.0/particles.min.js" defer></script>
<script>
    import '../../scripts/particles';
</script>
