---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';
import { getService, servicePath, CARD_UI_KEYS } from '../../data/services';

export interface Props {
    cityName?: string;
}

const { cityName } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const h2Content = cityName
    ? `${t('services_h2_city_pre')}<span class="gradient-text">${t('services_h2_city_accent')}</span> ${t('services_h2_city_post')} ${cityName}`
    : t('services_h2');

// Порядок: приоритет — автоматизация и AI, затем продукты, затем сайты
const cardOrder = ['bots', 'ai', 'saas', 'shop', 'websites', 'tma'] as const;
const cardSuffix = cityName ? ` ${t('services_card_city_suffix')} ${cityName}` : '';
const services = cardOrder.map((id, i) => ({
    id,
    icon: getService(id).section[lang as 'ru' | 'en'].icon,
    path: servicePath(id, lang as 'ru' | 'en'),
    h3Key: CARD_UI_KEYS[id].h3 as Parameters<typeof t>[0],
    pKey: CARD_UI_KEYS[id].p as Parameters<typeof t>[0],
    delay: (i + 1) * 100,
}));
---
<section id="services">
    <div class="container">
        <h2 class="section-title fade-in" set:html={h2Content}></h2>
        <div class="services-grid">
            {services.map(s => (
            <a href={s.path} class="card fade-in" style={`transition-delay: ${s.delay}ms;`}>
                <div class="card-glass-effect"></div>
                <Icon name={s.icon} class="card-icon" aria-hidden="true" />
                <h3>{t(s.h3Key)}{cardSuffix}</h3>
                <p>{t(s.pKey)}</p>
                <div class="card-footer">
                    <span class="learn-more">{t('services_learn_more')} <i class="fa-solid fa-arrow-right"></i></span>
                </div>
            </a>
            ))}
        </div>
<style>
    .card {
        height: 100%;
        max-width: 420px;
        justify-self: center;
        width: 100%;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .card:hover {
        transition-delay: 0s !important;
    }
    .card-glass-effect {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(var(--accent-color-start-rgb), 0.05), transparent 60%);
        pointer-events: none;
    }
    .card-footer {
        margin-top: auto;
        padding-top: 2rem;
    }
    .learn-more {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--accent-color);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: gap 0.3s ease;
    }
    :global(.light-theme) .learn-more {
        color: #E65200; /* Darker accent for light theme contrast */
    }
    .card:hover .learn-more {
        gap: 0.8rem;
    }
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2.5rem;
        margin: 4rem auto;
        max-width: 1400px;
    }
</style>
    </div>
</section>