---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icon from '../Icon.astro';

export interface Props {
    cityName?: string;
}

const { cityName } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const h2Content = cityName 
    ? (lang === 'ru' 
        ? `ИТ <span class="gradient-text">Услуги</span> в ${cityName}` 
        : `IT <span class="gradient-text">Services</span> in ${cityName}`)
    : t('services_h2');

const cardSuffix = cityName ? (lang === 'ru' ? ` для бизнеса в ${cityName}` : ` for ${cityName} businesses`) : '';

// Порядок: приоритет — автоматизация и AI, затем продукты, затем сайты
const services = [
    { icon: 'fa-cogs', path: lang === 'ru' ? 'uslugi/razrabotka-botov-i-parserov' : 'services/bot-and-scraper-development', h3Key: 'services_card2_h3', pKey: 'services_card2_p', delay: 100 },
    { icon: 'fa-brain', path: lang === 'ru' ? 'uslugi/ai-integracii' : 'services/ai-integration', h3Key: 'services_card4_h3', pKey: 'services_card4_p', delay: 200 },
    { icon: 'fa-rocket', path: lang === 'ru' ? 'uslugi/saas-mvp' : 'services/saas-mvp', h3Key: 'services_card3_h3', pKey: 'services_card3_p', delay: 300 },
    { icon: 'fa-cart-shopping', path: lang === 'ru' ? 'uslugi/internet-magaziny' : 'services/ecommerce-development', h3Key: 'services_card_shop_h3', pKey: 'services_card_shop_p', delay: 400 },
    { icon: 'fa-laptop-code', path: lang === 'ru' ? 'uslugi/razrabotka-saitov' : 'services/website-development', h3Key: 'services_card1_h3', pKey: 'services_card1_p', delay: 500 },
    { icon: 'fa-brands fa-telegram', path: lang === 'ru' ? 'uslugi/telegram-mini-apps' : 'services/telegram-mini-apps', h3Key: 'services_card5_h3', pKey: 'services_card5_p', delay: 600 },
] as const;
---
<section id="services">
    <div class="container">
        <h2 class="section-title fade-in" set:html={h2Content}></h2>
        <div class="services-grid">
            {services.map(s => (
            <a href={getRelativeLocaleUrl(lang, s.path)} class="card fade-in" style={`transition-delay: ${s.delay}ms;`}>
                <div class="card-glass-effect"></div>
                <Icon name={s.icon} class="card-icon" aria-hidden="true" />
                <h3>{t(s.h3Key)}{cardSuffix}</h3>
                <p>{t(s.pKey)}</p>
                <div class="card-footer">
                    <span class="learn-more">{t('services_learn_more')} <i class="fa-solid fa-arrow-right"></i></span>
                </div>
            </a>
            ))}
        </div>
<style>
    .card {
        flex: 1 1 380px;
        max-width: 420px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        position: relative;
    }
    .card:hover {
        transition-delay: 0s !important;
    }
    .card-glass-effect {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top right, rgba(var(--accent-color-start-rgb), 0.05), transparent 60%);
        pointer-events: none;
    }
    .card-footer {
        margin-top: auto;
        padding-top: 2rem;
    }
    .learn-more {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--accent-color);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: gap 0.3s ease;
    }
    :global(.light-theme) .learn-more {
        color: #E65200; /* Darker accent for light theme contrast */
    }
    .card:hover .learn-more {
        gap: 0.8rem;
    }
    .services-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 2.5rem;
        margin: 4rem auto;
        justify-content: center;
        max-width: 1400px;
    }
</style>
    </div>
</section>